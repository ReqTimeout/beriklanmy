---
import FloatingWhatsApp from '../components/FloatingWhatsApp.svelte';
import CookieConsent from '../components/CookieConsent.astro';
// (NAPBlock removed - Footer.svelte already has canonical NAP info)
import Schema from '../components/Schema.astro';
import type { FAQItem, BreadcrumbItem, ServiceData, LocalBusinessData } from '../components/Schema.astro';

interface Props {
    title?: string;
    description?: string;
    canonical?: string;
    ogImage?: string;
    schema?: 'service' | 'organization' | 'auto';
    noindex?: boolean;
    prevUrl?: string;
    nextUrl?: string;
    faq?: FAQItem[];
    breadcrumb?: BreadcrumbItem[];
    service?: ServiceData;
    localBusiness?: LocalBusinessData;
    heroImage?: string;
    heroImageWidth?: number;
    heroImageHeight?: number;
}

const {
    title = 'Beriklan.my — Digital Marketing Agency Malaysia | Since 2016',
    description = 'Performance marketing agency serving Malaysia — Facebook Ads, Google Ads, TikTok Ads, YouTube and landing pages. Meta & Google certified team managing campaigns since 2016. Contact us.',
    canonical = 'https://beriklan.my/',
    ogImage = 'https://beriklan.my/og-image.png',
    schema = 'auto',
    noindex = false,
    prevUrl,
    nextUrl,
    faq,
    breadcrumb,
    service,
    localBusiness,
    heroImage,
    heroImageWidth = 1200,
    heroImageHeight = 675,
} = Astro.props as Props;

// Auto-detect schema: ProfessionalService on all pages (sitewide), Organization always
const showProfessional = schema === 'service' || schema === 'auto';
const showOrganization = true;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{title}</title>
		{heroImage && (
			<link
				rel="preload"
				as="image"
				href={heroImage}
				fetchpriority="high"
			/>
		)}
		<meta name="description" content={description} />
		<meta name="keywords" content="digital marketing agency malaysia, facebook ads agency, google ads agency, tiktok ads agency, ppc management malaysia, landing page design, live stream viewers" />
		<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
		<meta name="language" content="English" />
		<meta name="author" content="Beriklan.my" />

		<link rel="canonical" href={canonical} />
		{prevUrl && <link rel="prev" href={prevUrl} />}
		{nextUrl && <link rel="next" href={nextUrl} />}

		<!-- Open Graph Tags -->
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonical} />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:site_name" content="Beriklan.my" />
		<meta property="og:locale" content="en_MY" />

		<!-- Twitter Card Tags -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="icon" type="image/svg+xml" href="/favicon.svg?v=2" />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png?v=2" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png?v=2" />
		<link rel="shortcut icon" href="/favicon.ico?v=2" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=2" />
		<link rel="icon" type="image/png" sizes="192x192" href="/favicon-192x192.png?v=2" />
		<link rel="icon" type="image/png" sizes="512x512" href="/favicon-512x512.png?v=2" />
		<meta name="generator" content={Astro.generator} />

		<link rel="stylesheet" href="/fonts/fonts.css">

		{showProfessional && (
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'ProfessionalService',
				name: 'Beriklan.my',
				description: 'Performance marketing agency serving Malaysia — Facebook Ads, Google Ads, TikTok Ads, landing pages and social media management.',
				url: 'https://beriklan.my',
				logo: 'https://beriklan.my/logoweb.webp',
				image: 'https://beriklan.my/logoweb.webp',
				priceRange: 'RM 790 - RM 6,999',
				telephone: '+62811919328',
				address: {
					'@type': 'PostalAddress',
					addressCountry: 'ID',
					addressLocality: 'Bandung',
					addressRegion: 'Jawa Barat'
				},
				areaServed: { '@type': 'Country', 'name': 'Malaysia' },
				openingHours: 'Mo-Sa 09:00-18:00',
				knowsAbout: ['Facebook Ads', 'Google Ads', 'TikTok Ads', 'Performance Marketing', 'Landing Page', 'Conversion Optimization'],
			})}></script>
		)}

		{showOrganization && (
			<script type="application/ld+json" set:html={JSON.stringify({
				'@context': 'https://schema.org',
				'@type': 'Organization',
				name: 'Beriklan.my',
				url: 'https://beriklan.my',
				logo: 'https://beriklan.my/logoweb.webp',
				description: 'Performance marketing agency serving Malaysia — managing paid media campaigns since 2016.',
				foundingDate: '2016',
				sameAs: [
					'https://www.instagram.com/beriklan.my',
					'https://www.facebook.com/beriklan.my'
				]
			})}></script>
		)}

		{/* P1: Additional structured data — FAQ, Breadcrumb, Service, LocalBusiness */}
		<Schema faq={faq} breadcrumb={breadcrumb} service={service} localBusiness={localBusiness} />

		<!-- Google tag (gtag.js) — GA4 beriklan.my -->
		<script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-7RB4G5GC1X"></script>
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			function gtag(){dataLayer.push(arguments);}
			gtag('js', new Date());
			gtag('config', 'G-7RB4G5GC1X');
			gtag('config', 'G-PBQF8MMN40');
		</script>
		<!-- End Google tag -->

		<!-- Global dataLayer push helpers (GTM event tracking) -->
		<script is:inline>
			window.dataLayer = window.dataLayer || [];
			// Helper: derive event key + payload from any anchor or button
			function bk_attr(el, key) { return el.getAttribute(key) || el.dataset[key] || ''; }
			function bk_text(el) { return (el.textContent || '').trim().slice(0, 60); }
			function pushDL(obj) {
				if (obj && obj.event && typeof gtag === 'function') {
					var name = obj.event; var params = {};
					for (var k in obj) { if (k !== 'event') params[k] = obj[k]; }
					gtag('event', name, params);
				} else { window.dataLayer.push(obj); }
			}

			// ========== CLICK TRACKER (wa, tel, cta, internal, outbound, file) ==========
			document.addEventListener('click', function(e) {
				var t = e.target;
				while (t && t !== document.body) {
					if (t.tagName === 'A' || t.tagName === 'BUTTON') break;
					t = t.parentElement;
				}
				if (!t || t === document.body) return;
				var href = (t.href || bk_attr(t, 'href') || '').toLowerCase();
				var isWa = href.indexOf('wa.me/') !== -1 || href.indexOf('whatsapp') !== -1;
				var isTel = href.indexOf('tel:') === 0;
				var isDownload = /\.(pdf|doc|docx|xls|xlsx|zip|rar|7z|jpg|png|webp|svg)$/i.test(href.split('?')[0].split('#')[0]);
				var isOutbound = href && !href.startsWith(window.location.origin) && !href.startsWith('/') && !href.startsWith('#') && !isWa && !isTel;

				if (isWa) {
					pushDL({
						event: 'whatsapp_click',
						event_category: 'contact',
						event_label: t.dataset.cta || bk_text(t) || 'whatsapp',
						page_location: window.location.pathname,
						page_title: document.title,
						service_slug: t.dataset.service || '',
						package_name: t.dataset.package || '',
						package_price: t.dataset.price || '',
						cta_location: t.dataset.ctaLocation || '',
						link_url: t.href || ''
					});
				} else if (isTel) {
					pushDL({
						event: 'phone_click',
						event_category: 'contact',
						event_label: bk_text(t) || 'phone',
						link_url: t.href || '',
						page_location: window.location.pathname
					});
				} else if (isDownload) {
					var fname = href.split('/').pop().split('?')[0];
					var ext = (fname.match(/\.([^.]+)$/) || ['','file'])[1];
					pushDL({
						event: 'file_download',
						event_category: 'engagement',
						event_label: fname,
						file_name: fname,
						file_extension: ext,
						link_url: t.href || '',
						page_location: window.location.pathname
					});
				} else if (isOutbound) {
					pushDL({
						event: 'outbound_click',
						event_category: 'engagement',
						event_label: bk_text(t) || t.hostname,
						outbound_url: t.href || '',
						page_location: window.location.pathname
					});
				} else if (t.hostname === window.location.hostname && t.pathname && t.pathname !== window.location.pathname) {
					// Internal link click (different page on same site)
					pushDL({
						event: 'internal_link_click',
						event_category: 'engagement',
						event_label: bk_text(t),
						internal_link_text: bk_text(t),
						internal_link_url: t.href || '',
						page_location: window.location.pathname
					});
				}

				// Generic CTA tracking
				if (t.dataset.cta) {
					pushDL({
						event: 'cta_click',
						event_category: 'engagement',
						event_label: t.dataset.cta,
						cta_text: bk_text(t),
						cta_location: t.dataset.ctaLocation || '',
						page_location: window.location.pathname
					});
				}
			}, true);

			// ========== PRICING TIER VIEW (IntersectionObserver) ==========
			(function() {
				if (typeof IntersectionObserver === 'undefined') return;
				var io = new IntersectionObserver(function(entries) {
					entries.forEach(function(en) {
						if (en.isIntersecting) {
							var el = en.target;
							pushDL({
								event: 'view_pricing_tier',
								event_category: 'engagement',
								event_label: el.dataset.tier || el.id || 'tier',
								package_name: el.dataset.tier || '',
								package_price: el.dataset.price || '',
								page_location: window.location.pathname
							});
							io.unobserve(el);
						}
					});
				}, { threshold: 0.4 });
				document.addEventListener('DOMContentLoaded', function() {
					document.querySelectorAll('[data-tier]').forEach(function(el) { io.observe(el); });
				});
			})();

			// ========== SCROLL DEPTH (25/50/75/100%) ==========
			(function() {
				var fired = {};
				function check() {
					var h = document.documentElement;
					var b = document.body;
					var st = window.pageYOffset || h.scrollTop || b.scrollTop;
					var sh = (h.scrollHeight || b.scrollHeight) - window.innerHeight;
					if (sh <= 0) return;
					var pct = Math.min(100, Math.round((st / sh) * 100));
					[25, 50, 75, 100].forEach(function(mark) {
						if (pct >= mark && !fired[mark]) {
							fired[mark] = true;
							pushDL({
								event: 'scroll_' + mark,
								event_category: 'engagement',
								event_label: 'scroll_' + mark,
								scroll_percent: mark,
								page_location: window.location.pathname
							});
						}
					});
				}
				var ticking = false;
				window.addEventListener('scroll', function() {
					if (!ticking) { requestAnimationFrame(function() { check(); ticking = false; }); ticking = true; }
				}, { passive: true });
				window.addEventListener('load', check);
			})();

			// ========== TIME ON PAGE (30/60/180s) ==========
			(function() {
				var startTime = Date.now();
				var fired = {};
				[30, 60, 180].forEach(function(s) {
					setTimeout(function() {
						if (fired[s]) return;
						fired[s] = true;
						pushDL({
							event: 'time_' + s + 's',
							event_category: 'engagement',
							event_label: 'time_' + s + 's',
							time_seconds: s,
							page_location: window.location.pathname
						});
					}, s * 1000);
				});
			})();

			// ========== BLOG READ COMPLETE (75% scroll on /blog/*) ==========
			(function() {
				if (window.location.pathname.indexOf('/blog/') !== 0) return;
				var fired = false;
				function checkRead() {
					if (fired) return;
					var h = document.documentElement;
					var b = document.body;
					var st = window.pageYOffset || h.scrollTop || b.scrollTop;
					var sh = (h.scrollHeight || b.scrollHeight) - window.innerHeight;
					if (sh <= 0) return;
					var pct = Math.min(100, Math.round((st / sh) * 100));
					if (pct >= 75) {
						fired = true;
						pushDL({
							event: 'blog_read_complete',
							event_category: 'engagement',
							event_label: 'read_75pct',
							page_location: window.location.pathname,
							page_title: document.title
						});
					}
				}
				var ticking = false;
				window.addEventListener('scroll', function() {
					if (!ticking) { requestAnimationFrame(function() { checkRead(); ticking = false; }); ticking = true; }
				}, { passive: true });
				window.addEventListener('load', checkRead);
			})();

			// ========== FORM START (first focus on form field) ==========
			(function() {
				var fired = false;
				document.addEventListener('focusin', function(e) {
					if (fired) return;
					var t = e.target;
					if (!t) return;
					if (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.tagName === 'SELECT') {
						var f = t.closest('form');
						if (f) {
							fired = true;
							pushDL({
								event: 'form_start',
								event_category: 'engagement',
								event_label: f.dataset.track || f.id || 'form',
								form_name: f.dataset.track || f.id || 'form',
								page_location: window.location.pathname
							});
						}
					}
				});
			})();

			// ========== FORM SUBMIT ==========
			document.addEventListener('submit', function(e) {
				var f = e.target;
				if (!f || f.tagName !== 'FORM') return;
				if (f.dataset.track) {
					pushDL({
						event: 'form_submit',
						event_category: 'conversion',
						event_label: f.dataset.track,
						form_name: f.dataset.track,
						page_location: window.location.pathname
					});
				}
			}, true);

			// ========== PAGE VIEW (manual + GTM own) ==========
			pushDL({
				event: 'page_view',
				page_location: window.location.pathname,
				page_title: document.title
			});
		</script>
	</head>
	<body class="font-sans text-primary bg-white antialiased pb-24 lg:pb-0">
		<slot />
	<FloatingWhatsApp client:only="svelte" />
	<CookieConsent />

	<!-- Scroll-triggered reveal system -->
	<script is:inline>
		(function() {
			if (typeof IntersectionObserver === 'undefined') return;
			// Mark html so CSS only hides elements when JS observer is ready
			document.documentElement.classList.add('js-reveal-ready');
			const items = document.querySelectorAll('[data-reveal], .reveal-stagger');
			if (!items.length) return;
			const io = new IntersectionObserver((entries) => {
				entries.forEach(e => {
					if (e.isIntersecting) {
						e.target.classList.add('revealed');
						io.unobserve(e.target);
					}
				});
			}, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
			items.forEach(el => io.observe(el));
		})();
	</script>

	<!-- Reveal observer (was: at end of file outside </html> — moved here) -->
	<script>
		(function() {
			if (typeof IntersectionObserver === 'undefined') return;
			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('revealed');
						observer.unobserve(entry.target);
					}
				}
			}, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
			const selector = '.reveal, .reveal-stagger, .reveal-lift, .reveal-left, .reveal-right';
			const seen = new WeakSet();
			function observeAll() {
				document.querySelectorAll(selector).forEach((el) => {
					if (!seen.has(el)) { seen.add(el); observer.observe(el); }
				});
			}
			if (document.readyState !== 'loading') observeAll();
			else document.addEventListener('DOMContentLoaded', observeAll);
			document.addEventListener('astro:page-load', observeAll);
			if (typeof MutationObserver !== 'undefined') {
				const mo = new MutationObserver((mutations) => {
					for (const m of mutations) {
						for (const n of m.addedNodes) {
							if (!(n instanceof Element)) continue;
							if (n.matches && n.matches(selector)) {
								if (!seen.has(n)) { seen.add(n); observer.observe(n); }
							}
							if (n.querySelectorAll) {
								n.querySelectorAll(selector).forEach((el) => {
									if (!seen.has(el)) { seen.add(el); observer.observe(el); }
								});
							}
						}
					}
				});
				const startObs = () => {
					if (document.body) mo.observe(document.body, { childList: true, subtree: true });
					else setTimeout(startObs, 50);
				};
				startObs();
			}
			let ticks = 0;
			const id = setInterval(() => {
				observeAll();
				if (++ticks > 5) clearInterval(id);
			}, 1500);
		})();
	</script>

	<!-- Newsletter form handler (P2.6) -->
	<script is:inline>
		(function() {
			function attachNewsletter() {
				var form = document.getElementById('nl-form');
				if (!form || form.__attached) return;
				form.__attached = true;
				var status = form.querySelector('.nl-status');
				var btn = form.querySelector('button[type="submit"]');
				form.addEventListener('submit', async function(e) {
					e.preventDefault();
					if (btn.disabled) return;
					var honeypot = form.querySelector('input[name="website"]').value;
					if (honeypot) { status.textContent = 'Thank you!'; status.className = 'nl-status text-xs text-green-300'; return; }
					var email = form.querySelector('input[name="email"]').value.trim().toLowerCase();
					var name = form.querySelector('input[name="name"]').value.trim();
					if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
						status.textContent = 'Invalid email format.';
						status.className = 'nl-status text-xs text-red-300';
						return;
					}
					btn.disabled = true;
					btn.textContent = '...';
					try {
						var r = await fetch('/api/newsletter/subscribe', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: email, name: name,
								page_url: location.pathname, source: document.referrer || ''
							}),
						});
						var data = await r.json();
						if (data.ok) {
							status.textContent = data.already ? 'You are already subscribed.' : 'Thank you! We will send updates to your email.';
							status.className = 'nl-status text-xs text-green-300';
							form.querySelector('input[name="email"]').value = '';
							form.querySelector('input[name="name"]').value = '';
						} else {
							status.textContent = data.error || 'Failed. Please try again.';
							status.className = 'nl-status text-xs text-red-300';
						}
					} catch (err) {
						status.textContent = 'Could not reach the server.';
						status.className = 'nl-status text-xs text-red-300';
					}
					btn.disabled = false;
					btn.textContent = 'Subscribe';
				});
			}
			if (document.readyState !== 'loading') attachNewsletter();
			else document.addEventListener('DOMContentLoaded', attachNewsletter);
			document.addEventListener('astro:page-load', attachNewsletter);
		})();
	</script>
	</body>
</html>

<style is:global>
    html {
        scroll-behavior: smooth;
    }
    
    /* Soft fade-in animation */
    .animate-gradient {
        background-size: 200% 200%;
        animation: gradient-move 12s ease infinite;
    }
    
    @keyframes gradient-move {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }
    
    .no-scrollbar::-webkit-scrollbar {
        display: none;
    }
    
    /* === GLOBAL: smooth scroll-reveal animations (progressive enhancement) ===
       Content is visible by default. JS marks html.js-reveal-ready BEFORE the
       observer runs, so reveal animation only hides content when JS is alive
       and ready to reveal it. If JS / observer fails, content stays visible. */
    @media (prefers-reduced-motion: no-preference) {
        html.js-reveal-ready .reveal {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        html.js-reveal-ready .reveal.revealed { opacity: 1; transform: translateY(0); }
        
        /* Reveal animation — progressive enhancement.
           Children start visible by default; if JS marks .js-reveal-ready on
           html, we hide them and the observer flips to .revealed on scroll.
           This guarantees content is visible even if JS / observer fails. */
        html.js-reveal-ready .reveal-stagger > * {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        html.js-reveal-ready .reveal-stagger.revealed > * { opacity: 1; transform: translateY(0); }
        .reveal-stagger.revealed > *:nth-child(1) { transition-delay: 0ms; }
        .reveal-stagger.revealed > *:nth-child(2) { transition-delay: 80ms; }
        .reveal-stagger.revealed > *:nth-child(3) { transition-delay: 160ms; }
        .reveal-stagger.revealed > *:nth-child(4) { transition-delay: 240ms; }
        .reveal-stagger.revealed > *:nth-child(5) { transition-delay: 320ms; }
        .reveal-stagger.revealed > *:nth-child(6) { transition-delay: 400ms; }
        .reveal-stagger.revealed > *:nth-child(7) { transition-delay: 480ms; }
        .reveal-stagger.revealed > *:nth-child(8) { transition-delay: 560ms; }
        .reveal-stagger.revealed > *:nth-child(9) { transition-delay: 640ms; }
        .reveal-stagger.revealed > *:nth-child(10) { transition-delay: 720ms; }
        
        .reveal-lift {
            opacity: 0;
            transform: translateY(40px) scale(0.96);
            transition: opacity 800ms cubic-bezier(0.22, 1, 0.36, 1), transform 800ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .reveal-lift.revealed { opacity: 1; transform: translateY(0) scale(1); }
        
        .reveal-left {
            opacity: 0;
            transform: translateX(-30px);
            transition: opacity 700ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        .reveal-left.revealed { opacity: 1; transform: translateX(0); }
        
        .reveal-right {
            opacity: 0;
            transform: translateX(30px);
            transition: opacity 700ms ease, transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }
