    /* === GLOBAL: smooth scroll-reveal animations (progressive enhancement) ===
       Content is visible by default. JS marks html.js-reveal-ready BEFORE the
       observer runs, so reveal animation only hides content when JS is alive
       and ready to reveal it. If JS / observer fails, content stays visible. */
    @media (prefers-reduced-motion: no-preference) {
        html.js-reveal-ready .reveal {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 700ms cubic-bezier(0.22, 1, 0.36, 1), transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        html.js-reveal-ready .reveal.revealed { opacity: 1; transform: translateY(0); }
        
        /* Reveal animation — progressive enhancement.
           Children start visible by default; if JS marks .js-reveal-ready on
           html, we hide them and the observer flips to .revealed on scroll.
           This guarantees content is visible even if JS / observer fails. */
        html.js-reveal-ready .reveal-stagger > * {
            opacity: 0;
            transform: translateY(16px);
            transition: opacity 600ms cubic-bezier(0.22, 1, 0.36, 1), transform 600ms cubic-bezier(0.22, 1, 0.36, 1);
        }
        html.js-reveal-ready .reveal-stagger.revealed > * { opacity: 1; transform: translateY(0); }
        .reveal-stagger.revealed > *:nth-child(1) { transition-delay: 0ms; }
        .reveal-stagger.revealed > *:nth-child(2) { transition-delay: 80ms; }
        .reveal-stagger.revealed > *:nth-child(3) { transition-delay: 160ms; }
        .reveal-stagger.revealed > *:nth-child(4) { transition-delay: 240ms; }
        .reveal-stagger.revealed > *:nth-child(5) { transition-delay: 320ms; }
        .reveal-stagger.revealed > *:nth-child(6) { transition-delay: 400ms; }
        .reveal-stagger.revealed > *:nth-child(7) { transition-delay: 480ms; }
        .reveal-stagger.revealed > *:nth-child(8) { transition-delay: 560ms; }
        .reveal-stagger.revealed > *:nth-child(9) { transition-delay: 640ms; }
        .reveal-stagger.revealed > *:nth-child(10) { transition-delay: 720ms; }
        
        .reveal-lift {
