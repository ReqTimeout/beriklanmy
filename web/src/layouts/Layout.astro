	<!-- Scroll-triggered reveal system -->
	<script is:inline>
		(function() {
			if (typeof IntersectionObserver === 'undefined') return;
			// Mark html so CSS only hides elements when JS observer is ready
			document.documentElement.classList.add('js-reveal-ready');
			const items = document.querySelectorAll('[data-reveal], .reveal-stagger');
			if (!items.length) return;
			const io = new IntersectionObserver((entries) => {
				entries.forEach(e => {
					if (e.isIntersecting) {
						e.target.classList.add('revealed');
						io.unobserve(e.target);
					}
				});
			}, { threshold: 0.05, rootMargin: '0px 0px -40px 0px' });
			items.forEach(el => io.observe(el));
		})();
	</script>

	<!-- Reveal observer (was: at end of file outside </html> — moved here) -->
	<script>
		(function() {
			if (typeof IntersectionObserver === 'undefined') return;
			const observer = new IntersectionObserver((entries) => {
				for (const entry of entries) {
					if (entry.isIntersecting) {
						entry.target.classList.add('revealed');
						observer.unobserve(entry.target);
					}
				}
			}, { threshold: 0.1, rootMargin: '0px 0px -60px 0px' });
			const selector = '.reveal, .reveal-stagger, .reveal-lift, .reveal-left, .reveal-right';
			const seen = new WeakSet();
			function observeAll() {
				document.querySelectorAll(selector).forEach((el) => {
					if (!seen.has(el)) { seen.add(el); observer.observe(el); }
				});
			}
			if (document.readyState !== 'loading') observeAll();
			else document.addEventListener('DOMContentLoaded', observeAll);
			document.addEventListener('astro:page-load', observeAll);
			if (typeof MutationObserver !== 'undefined') {
				const mo = new MutationObserver((mutations) => {
					for (const m of mutations) {
						for (const n of m.addedNodes) {
							if (!(n instanceof Element)) continue;
							if (n.matches && n.matches(selector)) {
								if (!seen.has(n)) { seen.add(n); observer.observe(n); }
							}
							if (n.querySelectorAll) {
								n.querySelectorAll(selector).forEach((el) => {
									if (!seen.has(el)) { seen.add(el); observer.observe(el); }
								});
							}
						}
					}
				});
				const startObs = () => {
					if (document.body) mo.observe(document.body, { childList: true, subtree: true });
					else setTimeout(startObs, 50);
				};
				startObs();
			}
			let ticks = 0;
			const id = setInterval(() => {
				observeAll();
				if (++ticks > 5) clearInterval(id);
			}, 1500);
		})();
	</script>

	<!-- Newsletter form handler (P2.6) -->
	<script is:inline>
		(function() {
			function attachNewsletter() {
				var form = document.getElementById('nl-form');
				if (!form || form.__attached) return;
				form.__attached = true;
				var status = form.querySelector('.nl-status');
				var btn = form.querySelector('button[type="submit"]');
				form.addEventListener('submit', async function(e) {
					e.preventDefault();
					if (btn.disabled) return;
					var honeypot = form.querySelector('input[name="website"]').value;
					if (honeypot) { status.textContent = 'Thank you!'; status.className = 'nl-status text-xs text-green-300'; return; }
					var email = form.querySelector('input[name="email"]').value.trim().toLowerCase();
					var name = form.querySelector('input[name="name"]').value.trim();
					if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
						status.textContent = 'Invalid email format.';
						status.className = 'nl-status text-xs text-red-300';
						return;
					}
					btn.disabled = true;
					btn.textContent = '...';
					try {
						var r = await fetch('/api/newsletter/subscribe', {
							method: 'POST',
							headers: { 'Content-Type': 'application/json' },
							body: JSON.stringify({
								email: email, name: name,
								page_url: location.pathname, source: document.referrer || ''
							}),
						});
						var data = await r.json();
						if (data.ok) {
							status.textContent = data.already ? 'You are already subscribed.' : 'Thank you! We will send updates to your email.';
							status.className = 'nl-status text-xs text-green-300';
							form.querySelector('input[name="email"]').value = '';
							form.querySelector('input[name="name"]').value = '';
						} else {
							status.textContent = data.error || 'Failed. Please try again.';
							status.className = 'nl-status text-xs text-red-300';
						}
					} catch (err) {
						status.textContent = 'Could not reach the server.';
						status.className = 'nl-status text-xs text-red-300';
					}
					btn.disabled = false;
					btn.textContent = 'Subscribe';
				});
			}
			if (document.readyState !== 'loading') attachNewsletter();
			else document.addEventListener('DOMContentLoaded', attachNewsletter);
			document.addEventListener('astro:page-load', attachNewsletter);
		})();
	</script>
