---
// AuthorBio.astro — E-E-A-T author section for pillar pages.
// Shows "Beriklan Team" credentials + facts.
// Props: none (universal content)
import { Award, Briefcase, ShieldCheck, Users } from 'lucide-svelte';
---
<section class="py-16 md:py-20 bg-soft" aria-label="About the Beriklan Team">
    <div class="container mx-auto px-6 max-w-5xl">
        <div class="grid md:grid-cols-[auto_1fr] gap-8 md:gap-10 items-center">
            <div class="flex-shrink-0">
                <div class="w-24 h-24 md:w-28 md:h-28 rounded-full bg-gradient-to-br from-primary to-primary-2 flex items-center justify-center text-white shadow-soft">
                    <span class="font-display font-extrabold text-3xl md:text-4xl">B</span>
                </div>
            </div>
            <div>
                <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent mb-2">Written by</p>
                <h2 class="text-2xl md:text-3xl font-display font-extrabold text-ink mb-3">The Beriklan Team</h2>
                <p class="text-base md:text-lg text-muted leading-relaxed mb-5">
                    A performance marketing team managing Meta, Google, TikTok and YouTube ad campaigns since 2016.
                    Experienced across more than 250 campaign audits for SMEs and mid-sized businesses —
                    from retail and F&B to professional services. Our approach is data-driven: diagnose first, then build the strategy.
                </p>
                <div class="flex flex-wrap gap-4 md:gap-6">
                    <div class="flex items-center gap-2">
                        <Briefcase class="w-5 h-5 text-accent" aria-hidden="true" />
                        <span class="text-sm font-semibold text-ink">9 years of experience</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <Award class="w-5 h-5 text-accent" aria-hidden="true" />
                        <span class="text-sm font-semibold text-ink">Meta & Google certified</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <Users class="w-5 h-5 text-accent" aria-hidden="true" />
                        <span class="text-sm font-semibold text-ink">250+ campaigns audited</span>
                    </div>
                    <div class="flex items-center gap-2">
                        <ShieldCheck class="w-5 h-5 text-accent" aria-hidden="true" />
                        <span class="text-sm font-semibold text-ink">Clients keep full account access</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>