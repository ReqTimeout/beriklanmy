---
// ComparisonTable.astro — Beriklan vs DIY comparison.
// Generic component; service-specific overrides via props.
import { Check, X } from 'lucide-svelte';

const { serviceName = 'Ads' } = Astro.props;

const rows = [
    {
        feature: 'Ad account setup + pixel tracking',
        diy: 'Risk of wrong conversion events, pixel not recording data',
        agency: 'Setup follows Meta/Google/TikTok best practice, pixel verified before launch'
    },
    {
        feature: 'Audience research & targeting',
        diy: 'Targeting too broad, budget spent with no results',
        agency: 'Layered interest + lookalike + retargeting, based on industry-specific audience research'
    },
    {
        feature: 'Ad production (copy + creative)',
        diy: 'Ads feel generic and fail to stand out in the feed',
        agency: '10+ creative variations per period, copy tailored to audience pain points'
    },
    {
        feature: 'Daily optimisation',
        diy: 'Weekly check-ins, unsure when to pause or scale',
        agency: 'Daily monitoring, bid adjustments, creative refresh based on real-time data'
    },
    {
        feature: 'Reporting & transparency',
        diy: 'Raw Ads Manager numbers without interpretation',
        agency: 'Weekly plain-language reports + monthly review via video call'
    },
    {
        feature: 'Ad account access',
        diy: 'Full (but you run everything yourself)',
        agency: 'Full — you remain the owner, we manage it'
    },
    {
        feature: 'Your time',
        diy: '5-10 hrs/week learning + executing',
        agency: 'Focus on your business, we manage the campaigns'
    },
];
---
<section class="py-16 md:py-20 bg-white" aria-label="Beriklan vs DIY Comparison">
    <div class="container mx-auto px-6 max-w-6xl">
        <div class="text-center mb-10">
            <p class="text-xs font-bold uppercase tracking-[0.2em] text-accent mb-3">An Honest Comparison</p>
            <h2 class="text-3xl md:text-4xl font-display font-extrabold text-ink mb-3">DIY {serviceName} vs Beriklan</h2>
            <p class="text-base md:text-lg text-muted max-w-2xl mx-auto">
                There is no right or wrong answer — only different priorities in time, budget and target outcomes.
                Here is what you get with each option.
            </p>
        </div>

        <div class="overflow-x-auto rounded-2xl shadow-soft border border-gray-100">
            <table class="w-full">
                <thead>
                    <tr class="bg-ink text-white">
                        <th class="text-left p-4 md:p-5 text-sm md:text-base font-bold">Aspect</th>
                        <th class="text-left p-4 md:p-5 text-sm md:text-base font-bold">Do It Yourself</th>
                        <th class="text-left p-4 md:p-5 text-sm md:text-base font-bold bg-accent text-ink">With Beriklan</th>
                    </tr>
                </thead>
                <tbody>
                    {rows.map((row, i) => (
                        <tr class={i % 2 === 0 ? 'bg-white' : 'bg-soft'}>
                            <td class="p-4 md:p-5 font-semibold text-ink text-sm md:text-base">{row.feature}</td>
                            <td class="p-4 md:p-5 text-muted text-sm md:text-base">
                                <X class="w-4 h-4 text-red-500 inline mr-2 flex-shrink-0" aria-hidden="true" />
                                <span>{row.diy}</span>
                            </td>
                            <td class="p-4 md:p-5 text-ink text-sm md:text-base bg-amber-50/40">
                                <Check class="w-4 h-4 text-green-600 inline mr-2 flex-shrink-0" aria-hidden="true" />
                                <span>{row.agency}</span>
                            </td>
                        </tr>
                    ))}
                </tbody>
            </table>
        </div>

        <p class="text-sm text-muted text-center mt-6 max-w-3xl mx-auto">
            This is not about convincing you — it is a business decision only you can make.
            If you have 5-10 hours a week to learn Meta/Google Ads and enjoy experimenting, DIY is perfectly fine.
            If you want measurable results without learning the platforms, we are happy to talk.
        </p>
    </div>
</section>