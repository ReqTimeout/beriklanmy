---
import Layout from '../layouts/Layout.astro';

import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import PricingCards from '../components/PricingCards.svelte';
import FaqAccordion from '../components/FaqAccordion.svelte';
import RelatedServices from '../components/RelatedServices.svelte';
import FeatureGrid from '../components/FeatureGrid.svelte';
import StepGrid from '../components/StepGrid.svelte';
import Footer from '../components/Footer.svelte';
import { MessageCircle, ArrowRight, Radio, Sparkles, Target, Zap, Users, Shield, Database, Clock, Tv, Cast, TrendingUp, Check, Smartphone, Globe } from 'lucide-svelte';

const waLink = "https://wa.me/62811919328?text=Hi%20Beriklan%2C%20I%27m%20interested%20in%20live%20stream%20viewers.%20Please%20share%20packages%20and%20pricing.";

const tiers = [
    { name: 'Warm-up', priceLabel: '5', duration: '20 viewers / 1 hour live', tagline: 'Perfect for short lives, tests, or warming up before your main live.', features: ['20 real active viewers joining gradually', 'Up to 1 hour of live time', 'Works across all live platforms', 'Great for short or test lives', 'Zero risk to your account'], priceNote: 'price per live session', disclaimer: 'Real accounts, no bots.' },
    { name: 'Starter', priceLabel: '10', duration: '50 viewers / 1 hour live', tagline: 'For regular lives that need an early boost so the algorithm notices you.', features: ['50 real active viewers', 'Up to 1 hour of live time', 'Works across all live platforms', 'Great for new sellers & streamers', 'Star Pick — the most popular package'], priceNote: 'RM 0.20/viewer/hour', disclaimer: 'Weekly/monthly bundle bonus: 10–15% off.', highlight: true },
    { name: 'Basic', priceLabel: '19', duration: '100 viewers / 1 hour live', tagline: 'The sweet spot for Shopee Live sellers who want to boost ranking.', features: ['100 real viewers staying the whole live', 'Up to 1 hour of live time', 'Works across all live platforms', 'Great for Shopee / TikTok Shop sellers', 'Real accounts, no bots — safe for your account'], priceNote: 'RM 0.19/viewer/hour', disclaimer: 'Ideal for weekly lives / consistent algorithm boosts.' },
    { name: 'Pro', priceLabel: '35', duration: '200 viewers / 1 hour live', tagline: 'For serious conversion pushes and product placement.', features: ['200 real active viewers', 'Up to 1 hour of live time', 'Works across all live platforms', 'Great for product launches & events', 'Priority WhatsApp support'], priceNote: 'RM 0.18/viewer/hour', disclaimer: 'Special discount on repeat orders.' },
    { name: 'Business', priceLabel: '49', duration: '300 viewers / 1 hour live', tagline: 'For brands and stores running live commerce daily.', features: ['300 real active viewers', 'Up to 1 hour of live time', 'Works across all live platforms', 'Great for brands with regular live commerce', 'Priority support + account manager'], priceNote: 'RM 0.16/viewer/hour', disclaimer: 'Ideal for weekly bundles on a fixed schedule.' },
    { name: 'Premium', priceLabel: '75', duration: '500 viewers / 1 hour live', tagline: 'For major launch events or lives with high viewer targets.', features: ['500 real active viewers', 'Up to 1 hour of live time', 'Works across all live platforms', 'Great for launches / corporate events', '24/7 support + flexible rescheduling'], priceNote: 'RM 0.15/viewer/hour', disclaimer: 'For 500+ viewers or monthly packages, custom pricing.' },
];

const features = [
    { iconName: 'Sparkles', title: 'Real Accounts, No Bots', desc: 'Our viewers are active accounts — not automation bots. Human behaviour, natural interaction, no platform flags.' },
    { iconName: 'Users', title: 'Organic Algorithm Boost', desc: 'Platforms (TikTok, Shopee, YouTube, IG, Twitch) prioritise lives with active viewers — boosting exposure 3–5x wider than usual.' },
    { iconName: 'TrendingUp', title: 'Gradual Join Over 5–15 Minutes', desc: 'Viewers never appear all at once. They join gradually from the first minute — making your live look organic and trending on For You / Explore.' },
    { iconName: 'Shield', title: 'Safe for Your Account', desc: 'Viewers never spam likes/comments that trigger platform flags. Nothing happens from your account — we handle everything viewer-side. Used by 1,200+ sellers without a single issue.' },
    { iconName: 'Smartphone', title: 'Multi-Platform at Once', desc: 'One order, five platforms. TikTok + Shopee + YouTube + Instagram + Twitch lives — all boosted simultaneously.' },
    { iconName: 'Clock', title: 'Starts Within 5 Minutes', desc: 'Once your order is confirmed, viewers start joining. No need to pre-record — if your live is already running, we join in real time.' },
];

const steps = [
    { num: '01', tag: 'DAY OF', title: 'Send Your Live Details', desc: 'Share your username/platform/date/start time with our team on WhatsApp. Orders confirmed within 30 minutes of complete details.' },
    { num: '02', tag: 'DAY OF', title: 'Payment & Preparation', desc: 'Transfer via bank or e-wallet (DuitNow/TNG). Invoice sent immediately. 50% deposit available for larger packages.' },
    { num: '03', tag: 'LIVE', title: 'Viewers Join In', desc: 'When your live starts, our viewers join gradually within 5–15 minutes. Never sudden, never suspicious — it looks natural.' },
    { num: '04', tag: 'POST-LIVE', title: 'Review & Recurrence', desc: 'After the live ends, we can review performance. Want a fixed Tuesday–Friday schedule? 10–15% off recurring packages.' },
];

const faqs = [
    { q: 'Are the viewers bots or real accounts?', a: 'Real accounts, no automation. They are active platform users who stay for the full live duration. Their interaction is natural and human — no like/comment spam that could trigger flags.' },
    { q: 'Is it safe for my account?', a: 'Completely safe. Nothing unusual ever happens from your account — all activity comes from the viewers, not you. Used by 1,200+ sellers and streamers without a single account issue.' },
    { q: 'How soon do viewers appear after I order?', a: '5–15 minutes after your live starts. Never all at once — gradual, just like a normal live.' },
    { q: 'Which platforms are supported?', a: 'TikTok Live, Shopee Live, YouTube Live, Instagram Live, Twitch and Lazada Live. Other platforms that support live streaming can work too — just chat with us to confirm.' },
    { q: 'Can I order more than 500 viewers, or a monthly package?', a: 'Yes. For 500+ viewers or weekly/monthly packages on a fixed schedule, chat with us on WhatsApp first for the best rate. Recurring schedules (e.g. every Tuesday & Friday) get an extra 10–15% off.' },
    { q: 'What happens if viewers drop before the session ends?', a: 'If viewers drop due to force majeure or a platform issue, we refund pro-rata or replace the viewers in your next session. Communication first — we are responsive humans, not a template bot.' },
    { q: 'Is there a minimum live duration?', a: 'One session = viewers for 1 hour of live time. For longer lives, we can count it as multiple sessions or build a custom package.' },
];

const relatedItems = [
    { icon: '📱', label: 'TikTok Ads Management', desc: 'For TikTok lives already running that need extra paid traffic.', href: '/tiktok-ads-management' },
    { icon: '🛍️', label: 'Instagram Management', desc: 'Ongoing Instagram content management for omni-channel marketing.', href: '/instagram-management' },
    { icon: '🎬', label: 'YouTube Ads Management', desc: 'For YouTube Ads targeting dedicated viewers.', href: '/youtube-ads-management' },
];

const categoryLabels = {
    'meta': 'Facebook & Instagram',
    'tiktok': 'TikTok',
    'google': 'Google Ads',
    'youtube': 'YouTube',
    'strategy': 'Strategi',
    'case-study': 'Studi Kasus',
};
---

<Layout title="Live Stream Viewers Malaysia | TikTok, Shopee, YouTube, IG, Twitch — Beriklan" description="Boost live stream viewers for TikTok, Shopee, YouTube, Instagram and Twitch. Real accounts, no bots, safe for your account. From RM 5 for 20 viewers." canonical="https://beriklan.my/live-stream-viewers/">

    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <!-- ====================== HERO ====================== -->
    <header class="hero relative pt-28 md:pt-44 pb-16 md:pb-24 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="absolute inset-0 opacity-[0.4] pointer-events-none hero-grid"></div>
        <div class="abs-blob abs-blob-1"></div>
        <div class="abs-blob abs-blob-2"></div>

        <svg class="absolute left-1/2 -translate-x-1/2 top-32 w-40 h-12 opacity-30 hidden lg:block" viewBox="0 0 160 40" aria-hidden="true">
            <path d="M5,20 Q40,5 80,20 T155,20" stroke="#0f1e3d" stroke-width="1.5" fill="none" stroke-dasharray="3 5"/>
        </svg>

        <div class="container mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">
            <div class="space-y-7 text-center lg:text-left">
                <div class="hero-eyebrow inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-ink font-semibold rounded-full text-xs tracking-wider uppercase shadow-sm">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
                    </span>
                    <Radio class="w-3 h-3" />
                    <span class="opacity-0 anim-fade-in">Live Stream Viewers · TikTok, Shopee, YouTube, IG, Twitch</span>
                </div>

                <h1 class="hero-h1 font-display font-extrabold text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[2.9rem] text-ink leading-[1.05] tracking-tight">
                    <span class="anim-fade-up">A Quiet Live,</span><br/>
                    <span class="anim-fade-up text-transparent bg-clip-text bg-gradient-to-r from-primary-2 to-accent" style="animation-delay: 80ms;">The Algorithm Won’t Pick It Up</span><br/>
                    <span class="anim-fade-up" style="animation-delay: 160ms;">— We’re the Fix.</span>
                </h1>

                <p class="hero-sub text-base md:text-lg text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 anim-fade-up" style="animation-delay: 240ms;">
                    TikTok, Shopee Live and YouTube Live algorithms all follow one principle: busy lives rise. Our real viewers join gradually from the first minute, making your live look trending — no flags, no bots, no risk to your account.
                </p>

                <div class="hero-ctas flex flex-col sm:flex-row gap-3 justify-center lg:justify-start pt-2 anim-fade-up" style="animation-delay: 320ms;">
                    <a href={waLink} target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center gap-2 bg-ink text-white px-7 py-4 rounded-full font-bold shadow-lg hover:shadow-pop overflow-hidden btn-shine">
                        <span class="relative z-10 flex items-center gap-2">
                            Order Live Viewers
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 group-hover:rotate-12 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </span>
                    </a>
                    <a href="#pricing" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-bold text-ink border border-gray-200 bg-white hover:border-ink hover:-translate-y-0.5 transition-all">
                        View Packages & Pricing
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                </div>

                <div class="hero-trust pt-6 border-t border-gray-200/60 flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-3 text-xs md:text-sm reveal" style="transition-delay: 200ms;">
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted"><strong class="text-ink">From RM 5</strong> for 20 viewers</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Real account, <strong class="text-ink">no bot</strong></span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Safe for your account</span></div>
                </div>
            </div>

            <div class="relative flex justify-center lg:justify-end anim-fade-up" style="animation-delay: 400ms;">
                <!-- Live streaming preview -->
                <div class="relative w-full max-w-md mx-auto">
                    <div class="rounded-3xl overflow-hidden bg-gradient-to-br from-primary-2 to-ink border-4 border-white shadow-2xl aspect-[9/16] max-h-[560px] relative">
                        <!-- Top bar: TikTok style -->
                        <div class="absolute top-0 left-0 right-0 p-3 flex items-center gap-2 bg-gradient-to-b from-ink/80 to-transparent z-10">
                            <div class="w-8 h-8 rounded-full bg-gradient-to-br from-pink-500 to-accent flex items-center justify-center text-white text-xs font-bold">@</div>
                            <div class="flex-1">
                                <p class="text-white text-xs font-bold">@your_brand</p>
                                <p class="text-white/70 text-[10px] flex items-center gap-1">
                                    <span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
                                    LIVE
                                </p>
                            </div>
                            <div class="px-2 py-1 bg-red-500 text-white text-[10px] font-bold rounded-full uppercase tracking-wider">Live</div>
                        </div>
                        <!-- Viewer count -->
                        <div class="absolute top-12 right-3 z-10 px-2 py-1 bg-white/15 backdrop-blur-md rounded-full text-white text-[10px] font-bold flex items-center gap-1">
                            <Users class="w-3 h-3" />
                            <span>500 viewers</span>
                        </div>
                        <!-- Chat overlay -->
                        <div class="absolute bottom-12 left-3 right-3 space-y-1.5 z-10 max-h-32 overflow-hidden">
                            <div class="flex items-start gap-1.5">
                                <span class="px-1.5 py-0.5 bg-white/20 backdrop-blur-sm text-white text-[10px] font-bold rounded">User1</span>
                                <span class="text-white text-[11px] drop-shadow">this live is awesome 🔥</span>
                            </div>
                            <div class="flex items-start gap-1.5">
                                <span class="px-1.5 py-0.5 bg-white/20 backdrop-blur-sm text-white text-[10px] font-bold rounded">User2</span>
                                <span class="text-white text-[11px] drop-shadow">can I get that discount?</span>
                            </div>
                            <div class="flex items-start gap-1.5">
                                <span class="px-1.5 py-0.5 bg-white/20 backdrop-blur-sm text-white text-[10px] font-bold rounded">User3</span>
                                <span class="text-white text-[11px] drop-shadow">is it still in stock?</span>
                            </div>
                        </div>
                        <!-- Bottom CTA -->
                        <div class="absolute bottom-0 left-0 right-0 p-3 bg-gradient-to-t from-ink/90 to-transparent">
                            <div class="bg-accent text-ink text-center py-2 rounded-full text-xs font-bold">BUY NOW</div>
                        </div>
                        <!-- Product overlay -->
                        <div class="absolute inset-0 flex items-center justify-center pointer-events-none">
                            <div class="w-32 h-32 rounded-2xl bg-gradient-to-br from-accent/30 to-pink-500/30 backdrop-blur-sm border-2 border-white/40 flex items-center justify-center">
                                <div class="text-center">
                                    <p class="text-white text-[10px] font-bold uppercase tracking-wider">Featured</p>
                                    <p class="text-white text-base font-bold">Product</p>
                                    <p class="text-accent text-sm font-extrabold">RM 29</p>
                                </div>
                            </div>
                        </div>
                        <!-- Live badge -->
                        <div class="absolute top-12 left-3 z-10">
                            <div class="flex items-center gap-1.5 bg-red-500 text-white text-[10px] font-bold px-2 py-1 rounded-full">
                                <span class="w-1.5 h-1.5 rounded-full bg-white animate-pulse"></span>
                                LIVE NOW
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- ====================== TRUST BAR ====================== -->
    <section class="py-7 bg-ink border-y border-white/5 relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                <p class="text-[10px] md:text-xs font-bold uppercase tracking-[0.18em] text-white/40">Works across every live platform</p>
                <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/70 text-sm font-semibold trust-word">
                    <span>TikTok Live</span><span class="text-white/30">·</span>
                    <span>Shopee Live</span><span class="text-white/30">·</span>
                    <span>YouTube Live</span><span class="text-white/30">·</span>
                    <span>Instagram Live</span><span class="text-white/30">·</span>
                    <span>Twitch</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== WHY FACEBOOK ADS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Why Live Viewers Matter
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    A quiet live = the algorithm ignores you.<br/>
                    <span class="text-accent">We know how to turn that around.</span>
                </h2>
                <p class="mt-4 text-muted max-w-xl mx-auto text-base leading-relaxed">
                    Every live platform — TikTok, Shopee, YouTube, Instagram, Twitch — shares one trait: they prioritise lives with active viewers. A live with 500 viewers surfaces 5x more often on For You / Explore than one with 50. We help you start that momentum.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto reveal-stagger">
                <div class="why-card group">
                    <div class="why-icon">
                        <Sparkles class="w-6 h-6" strokeWidth="2.2" />
                    </div>
                    <h3 class="why-title">Algorithm Boost</h3>
                    <p class="why-desc">Platforms prioritise lives with active viewers. Boost viewers = boost organic distribution up to 5x wider than usual.</p>
                </div>
                <div class="why-card group" style="animation-delay: 100ms;">
                    <div class="why-icon">
                        <Shield class="w-6 h-6" strokeWidth="2.2" />
                    </div>
                    <h3 class="why-title">100% Aman</h3>
                    <p class="why-desc">Our viewers are real accounts, not automation bots. Nothing happens from your account — used by 1,200+ sellers without a single issue.</p>
                </div>
                <div class="why-card group" style="animation-delay: 200ms;">
                    <div class="why-icon">
                        <Globe class="w-6 h-6" strokeWidth="2.2" />
                    </div>
                    <h3 class="why-title">Multi-Platform</h3>
                    <p class="why-desc">One order = a boost on TikTok, Shopee, YouTube, Instagram and Twitch at once. Saves time and money versus ordering separately.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== FEATURES GRID ====================== -->
    <section id="fitur" class="py-20 md:py-28 bg-soft relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    6 Service Advantages
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Why our service is different<br/>
                    <span class="text-accent">dari viewer bot pada umumnya.</span>
                </h2>
            </div>

            <FeatureGrid items={features} client:visible />
        </div>
    </section>

    <!-- ====================== HOW IT WORKS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, rgba(15,30,61,0.05) 1px, transparent 0); background-size: 32px 32px;"></div>

        <div class="container mx-auto px-6 relative">
            <div class="max-w-2xl mx-auto text-center mb-14 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-6 h-px bg-accent"></span>
                    How It Works
                    <span class="w-6 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    From order to a busy live,<br/>
                    <span class="text-accent">in under 30 minutes.</span>
                </h2>
            </div>

            <StepGrid items={steps} client:visible />
        </div>
    </section>

    <!-- ====================== PRICING ====================== -->
    <section id="pricing" class="py-20 md:py-28 bg-gradient-to-br from-soft via-white to-beige relative overflow-hidden">
        <div class="abs-blob abs-blob-3"></div>
        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Packages & Pricing
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Six packages, from warm-up<br/>
                    <span class="text-accent">to grand launches.</span>
                </h2>
                <p class="mt-4 text-muted max-w-xl mx-auto text-base leading-relaxed">
                    All packages include real viewers (not bots), gradual entry, and WhatsApp support. For weekly/monthly packages or 500+ viewers, chat with us first for custom pricing.
                </p>
            </div>

            <PricingCards tiers={tiers} pageSlug="View Live Multi-Platform" highlightIndex={1} columns={3} client:only="svelte" />

            <div class="mt-10 max-w-2xl mx-auto reveal">
                <div class="bg-white rounded-2xl border border-gray-100 p-5 md:p-6 shadow-soft">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-xl bg-accent/15 flex items-center justify-center shrink-0">
                            <Check class="w-5 h-5 text-accent" strokeWidth="2.5" />
                        </div>
                        <div>
                            <p class="font-display font-bold text-base text-ink mb-1">Need a recurring package or 500+ viewers?</p>
                            <p class="text-sm text-muted leading-relaxed">A consultation. We help you pick the package that best fits your live schedule and objective.</p>
                            <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 mt-3 text-sm font-bold text-accent hover:text-ink transition-colors group">
                                Chat via WhatsApp
                                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== STATS / TRUST ====================== -->
    <section class="py-20 md:py-28 bg-ink text-white relative overflow-hidden">
        <div class="abs-radaial-1"></div>
        <div class="stat-orb stat-orb-1"></div>
        <div class="stat-orb stat-orb-2"></div>

        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Real Proof
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-white leading-[1.1] tracking-tight mt-3">
                    1,200+ sellers &amp; streamers<br/>
                    <span class="text-accent">already use this service.</span>
                </h2>
                <p class="text-white/60 mt-4 text-base max-w-xl mx-auto">
                    No promises — only results you can verify yourself in your account.
                </p>
            </div>

            <div class="grid md:grid-cols-4 gap-4 max-w-5xl mx-auto reveal-stagger">
                <div class="stat-card">
                    <div class="stat-num">1.200+</div>
                    <div class="stat-label">Active sellers &amp; streamers</div>
                    <div class="stat-bar"><span style="width: 100%"></span></div>
                    <p class="stat-foot">across 2024–2026</p>
                </div>
                <div class="stat-card" style="animation-delay: 80ms;">
                    <div class="stat-num">5x</div>
                    <div class="stat-label">Distribution boost</div>
                    <div class="stat-bar"><span style="width: 85%"></span></div>
                    <p class="stat-foot">average For You / Explore</p>
                </div>
