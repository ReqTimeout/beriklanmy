---
import Layout from '../layouts/Layout.astro';

import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import InstagramCalendarMock from '../components/InstagramCalendarMock.svelte';
import PricingCards from '../components/PricingCards.svelte';
import FaqAccordion from '../components/FaqAccordion.svelte';
import PAASection from '../components/PAASection.astro';
import RelatedServices from '../components/RelatedServices.svelte';
import FeatureGrid from '../components/FeatureGrid.svelte';
import StepGrid from '../components/StepGrid.svelte';
import StatsBand from '../components/StatsBand.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Footer from '../components/Footer.svelte';
import relatedMap from '../data/related-services.json';
import { MessageCircle, ArrowRight, Target, Sparkles, Repeat, MapPin, Database, Users, Check, TrendingUp } from 'lucide-svelte';

const waLink = "https://wa.me/62811919328?text=Halo%20Beriklan%2C%20saya%20tertarik%20dengan%20jasa%20kelola%20Instagram.%20Mohon%20info%20paket%20dan%20harga.";

const tiers = [
    {
        name: 'Basic',
        priceLabel: '2.500.000',
        duration: '30 hari',
        tagline: 'Untuk bisnis yang ingin aktif rutin di Instagram dengan desain feed dan story yang konsisten.',
        features: [
            '15 desain feed (tanpa video)',
            '5 story',
            'Konsep, timeline, copy, posting',
            'Report bulanan',
            'Akses penuh ke akun Instagram Anda',
        ],
        priceNote: 'belum termasuk ad spend (opsional)',
        disclaimer: 'Tanpa kontrak panjang. Berhenti kapan saja.',
    },
    {
        name: 'Standart',
        priceLabel: '3.500.000',
        duration: '30 hari',
        tagline: 'Untuk bisnis yang ingin lebih aktif dengan tambahan konten video pendek dan foto produk.',
        features: [
            '20 desain feed',
            '2 short video (Reels)',
            '10 story',
            'Konsep, timeline, copy, posting, report',
            '15 foto produk*',
            'Akses penuh ke akun Instagram Anda',
        ],
        priceNote: 'belum termasuk ad spend (opsional)',
        disclaimer: 'Tanpa kontrak panjang. Berhenti kapan saja.',
        highlight: true,
    },
    {
        name: 'Business',
        priceLabel: 'Custom',
        duration: '30 hari',
        tagline: 'Untuk bisnis dengan kebutuhan khusus: produksi konten, UGC, campaign, atau kolaborasi influencer.',
        features: [
            'Custom jumlah konten',
            'Custom jumlah story',
            'Custom jumlah video pendek',
            'Strategi dan konsep tailor-made',
            'Kolaborasi dengan tim internal Anda',
            'Review bulanan via video call',
        ],
        priceNote: 'harga disesuaikan dengan scope',
        disclaimer: 'Tanpa kontrak panjang. Berhenti kapan saja.',
    },
];

const features = [
    { iconName: 'Camera', title: 'Desain Feed', desc: 'Setiap post melalui proses desain visual yang menjaga konsistensi estetika brand. Cocok untuk brand yang ingin feed terlihat profesional.' },
    { iconName: 'Sparkles', title: 'Story Harian', desc: 'Story diposting secara rutin untuk menjaga visibilitas di antara followers Anda. Format interaktif: polling, quiz, Q&A, countdown.' },
    { iconName: 'Video', title: 'Reels Pendek', desc: 'Video pendek 15-30 detik yang mengikuti tren, namun tetap relevan dengan brand. Cocok untuk menjangkau audiens baru lewat Explore.' },
    { iconName: 'MessageCircle', title: 'Manajemen DM', desc: 'Tim kami merespons DM dan komentar dengan tone brand yang konsisten. Respon cepat meningkatkan trust dan konversi.' },
    { iconName: 'BarChart3', title: 'Report Bulanan', desc: 'Laporan disusun dengan bahasa yang mudah dipahami: post mana yang perform, insight followers, reach, dan rekomendasi strategi.' },
    { iconName: 'Eye', title: 'Insight Audiens', desc: 'Kami analisis audiens Instagram Anda: siapa mereka, kapan aktif, konten apa yang paling engaging. Data ini menjadi dasar strategi bulan depan.' },
];

const steps = [
    { num: '01', tag: 'MINGGU 1', title: 'Brief & Brand Guidelines', desc: 'Diskusi 30 menit untuk menggali produk, target market, tone visual, dan referensi brand Anda. Kami susun brand guidelines dan content pillars.' },
    { num: '02', tag: 'MINGGU 1-2', title: 'Konsep & Produksi Konten', desc: 'Tim kami produksi desain, copy, dan konten visual sesuai brand guidelines. Anda approve konsep dan hasil akhir sebelum posting.' },
    { num: '03', tag: 'MINGGU 2+', title: 'Posting & Monitoring', desc: 'Konten diposting sesuai jadwal yang disusun. Kami monitor performa harian dan merespons DM/komentar untuk menjaga engagement.' },
    { num: '04', tag: 'BULANAN', title: 'Report & Iterasi', desc: 'Setiap bulan Anda menerima laporan lengkap: post mana yang perform, insight followers, dan rekomendasi strategi untuk bulan depan.' },
];

const faqs = [
    { q: 'Apa bedanya paket Basic, Standart, dan Business?', a: 'Basic untuk Anda yang butuh konten rutin (15 feed + 5 story per bulan, tanpa video). Standart menambahkan 2 Reels dan 10 foto produk untuk variasi lebih kaya. Business adalah paket custom dengan produksi konten menyeluruh dan strategi aktivasi khusus.' },
    { q: 'Apakah foto produk sudah termasuk dalam harga?', a: 'Untuk paket Standart, sudah termasuk 15 foto produk. Untuk paket Basic, foto produk disediakan oleh Anda. Untuk paket Business, kami produksi foto dan video sesuai kebutuhan.' },
    { q: 'Berapa lama sampai saya melihat hasil dari konten ini?', a: 'Engagement rate biasanya sudah terbaca di minggu ke-2 atau ke-3. Pertumbuhan followers yang konsisten baru terasa di bulan ke-2 atau ke-3. Untuk hasil bisnis (chat WhatsApp atau penjualan), biasanya kombinasi dengan paid ads memberikan hasil lebih cepat.' },
    { q: 'Bisakah konten diganti di tengah periode berjalan?', a: 'Bisa. Jika konsep awal kurang sesuai dengan respons audiens, kami revisi arah di tengah bulan. Ini bagian dari layanan — kami adaptif, bukan kaku.' },
    { q: 'Apakah ada kontrak minimum?', a: 'Tidak ada. Sistem kerja bulanan. Anda bebas lanjut atau berhenti setiap periode. Ini bentuk komitmen kami untuk menjaga kualitas kerja — bukan jebakan kontrak.' },
    { q: 'Apakah saya perlu tetap login ke akun Instagram saya?', a: 'Perlu — akses penuh ke akun Anda tetap dipegang. Kami yang mengeksekusi posting, menjawab komentar direct message opsional, dan memonitor insight. Semua perubahan terdokumentasi di laporan.' },
    { q: 'Bagaimana laporan yang diberikan?', a: 'Laporan bulanan mencakup performa setiap post, insight audiens (demografi, jam aktif, lokasi), reach dan engagement, serta rekomendasi topik dan format untuk bulan depan. Dikirim via email dan didiskusikan via WhatsApp atau video call.' },
];

const relatedItems = (relatedMap.services['instagram-management'] || []).map(item => ({
  icon: item.icon,
  label: item.label,
  desc: item.desc,
  href: '/' + item.slug + '/',
}));
---

<Layout title="Jasa Kelola Instagram Profesional — Beriklan" description="Akun Instagram Anda dijaga aktif — desain feed, story harian, copywriting Bahasa Indonesia, dan community management. Hemat waktu 5-10 jam per minggu. Mulai Rp 2,5 juta/bulan. Laporan bulanan via WhatsApp." canonical="https://beriklan.my/instagram-management/"
    faq={[
            { question: 'Berapa harga jasa kelola Instagram?', answer: 'Mulai dari Rp 1.500.000 per bulan. Sudah termasuk 12-15 post, story harian, reels mingguan, dan laporan.' },
            { question: 'Berapa post per minggu?', answer: '3-5 post feed, 5-7 story per hari, 1-2 reels per minggu. Sesuai paket dan target audiens.' },
            { question: 'Apakah tim Beriklan handle caption + hashtag?', answer: 'Ya, kami handle content calendar, copywriting caption, hashtag strategy, dan visual design.' },
            { question: 'Berapa lama sampai results terlihat?', answer: 'Engagement rate naik dalam 1-2 bulan. Follower growth konsisten di bulan ke-2. Optimal di bulan ke-3.' },
            { question: 'Apakah ada laporan bulanan?', answer: 'Ya, IG Insight report bulanan: reach, impressions, engagement rate, follower growth, dan rekomendasi bulan depan.' }
        ]}
    breadcrumb={[
        { name: "Beranda", url: "https://beriklan.my/" },
        { name: "Jasa Kelola Instagram", url: "https://beriklan.my/instagram-management/" }
    ]}
    service={{
        name: "Jasa Kelola Instagram",
        description: "Jasa Jasa Kelola Instagram profesional dari Beriklan.co.id. Tim bersertifikat, strategi terukur, laporan mingguan, dan optimasi rutin untuk UMKM & bisnis menengah di Indonesia.",
        url: "https://beriklan.my/instagram-management/",
        priceRange: "Rp 1.500.000 - Rp 3.000.000",
        serviceType: "Instagram Management",
        areaServed: "Indonesia",
        provider: { name: "Beriklan.co.id", url: "https://beriklan.my" }
    }}
>>

    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <!-- ====================== HERO ====================== -->
    <header class="hero relative pt-28 md:pt-44 pb-16 md:pb-24 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="absolute inset-0 opacity-[0.4] pointer-events-none hero-grid"></div>
        <div class="abs-blob abs-blob-1"></div>
        <div class="abs-blob abs-blob-2"></div>

        <svg class="absolute left-1/2 -translate-x-1/2 top-32 w-40 h-12 opacity-30 hidden lg:block" viewBox="0 0 160 40" aria-hidden="true">
            <path d="M5,20 Q40,5 80,20 T155,20" stroke="#0f1e3d" stroke-width="1.5" fill="none" stroke-dasharray="3 5"/>
        </svg>

        <div class="container mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">
            <div class="space-y-7 text-center lg:text-left">
                <div class="hero-eyebrow inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-ink font-semibold rounded-full text-xs tracking-wider uppercase shadow-sm">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
                    </span>
                    <span class="opacity-0 anim-fade-in">Jasa Kelola Instagram · Konten & Community</span>
                </div>

                <h1 class="hero-h1 font-display font-extrabold text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[2.9rem] text-ink leading-[1.05] tracking-tight">
                    <span class="anim-fade-up">Jasa Kelola Instagram</span><br/>
                    <span class="anim-fade-up text-transparent bg-clip-text bg-gradient-to-r from-primary-2 to-accent" style="animation-delay: 80ms;">Konsistensi Konten,</span><br/>
                    <span class="anim-fade-up" style="animation-delay: 160ms;">Pertumbuhan yang Terukur.</span>
                </h1>

                <p class="hero-sub text-base md:text-lg text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 anim-fade-up" style="animation-delay: 240ms;">
                    Instagram yang aktif dan tertata membutuhkan waktu dan konsistensi. Tim kami mengelola akun Instagram Anda secara menyeluruh — mulai dari konsep, copy, desain, penjadwalan, hingga laporan mingguan. Anda fokus pada bisnis, kami yang menjaga brand tetap hidup.
                </p>

                <div class="hero-ctas flex flex-col sm:flex-row gap-3 justify-center lg:justify-start pt-2 anim-fade-up" style="animation-delay: 320ms;">
                    <a href={waLink} target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center gap-2 bg-ink text-white px-7 py-4 rounded-full font-bold shadow-lg hover:shadow-pop overflow-hidden btn-shine">
                        <span class="relative z-10 flex items-center gap-2">
                            Diskusi via WhatsApp
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 group-hover:rotate-12 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </span>
                    </a>
                    <a href="#pricing" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-bold text-ink border border-gray-200 bg-white hover:border-ink hover:-translate-y-0.5 transition-all">
                        Lihat Paket & Harga
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                </div>

                <div class="hero-trust pt-6 border-t border-gray-200/60 flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-3 text-xs md:text-sm reveal" style="transition-delay: 200ms;">
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted"><strong class="text-ink">9 tahun</strong> mengelola campaign iklan</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Optimasi berbasis data, bukan tebakan</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Laporan <strong class="text-ink">setiap Senin</strong>, bahasa yang mudah dipahami</span></div>
                </div>
            </div>

            <div class="relative flex justify-center lg:justify-end anim-fade-up" style="animation-delay: 400ms;">
                <InstagramCalendarMock client:only="svelte" />
            </div>
        </div>
    </header>

    <!-- ====================== TRUST BAR ====================== -->
    <section class="py-7 bg-ink border-y border-white/5 relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                <p class="text-[10px] md:text-xs font-bold uppercase tracking-[0.18em] text-white/40">Dipercaya bisnis dari berbagai industri</p>
                <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/70 text-sm font-semibold trust-word">
                    <span>F&amp;B</span><span class="text-white/30">·</span>
                    <span>Skincare</span><span class="text-white/30">·</span>
                    <span>Fashion</span><span class="text-white/30">·</span>
                    <span>Edutech</span><span class="text-white/30">·</span>
                    <span>SaaS B2B</span><span class="text-white/30">·</span>
                    <span>Klinik</span><span class="text-white/30">·</span>
                    <span>Properti</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== STATS BAND ====================== -->
    <StatsBand />

    <!-- ====================== WHY FACEBOOK ADS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Kenapa Kelola Instagram
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Bukan sekadar posting rutin,<br/>
                    <span class="text-accent">tapi konten yang terukur dan selaras brand.</span>
                </h2>
                <p class="mt-4 text-muted max-w-xl mx-auto text-base leading-relaxed">
                    Instagram adalah platform di mana keputusan pembelian banyak terjadi — terutama untuk produk consumer. Namun menjalankan akun secara konsisten membutuhkan waktu: desain, copy, penjadwalan, interaksi dengan followers, hingga monitoring performa. Tim kami mengambil alih semua itu, dengan output yang terukur dan dapat Anda verifikasi kapan saja.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto reveal-stagger">
                <div class="why-card group">
                    <div class="why-icon">🎨</div>
                    <h3 class="why-title">Desain Feed yang Konsisten</h3>
                    <p class="why-desc">Kami menjaga feed Instagram Anda tertata dengan estetika brand yang konsisten. Setiap post melalui proses kurasi visual sebelum tayang.</p>
                </div>
                <div class="why-card group" style="animation-delay: 100ms;">
                    <div class="why-icon">📊</div>
                    <h3 class="why-title">Report yang Detail</h3>
                    <p class="why-desc">Laporan bulanan disusun dengan bahasa yang mudah dipahami: post mana yang perform, mana yang perlu iterasi, dan rekomendasi untuk bulan depan.</p>
                </div>
                <div class="why-card group" style="animation-delay: 200ms;">
                    <div class="why-icon">💬</div>
                    <h3 class="why-title">Interaksi Followers</h3>
                    <p class="why-desc">Tim kami mengelola balasan DM dan komentar untuk menjaga engagement tetap aktif. Respon cepat pada kolom komentar meningkatkan reach organik.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== FEATURES GRID ====================== -->
    <section id="fitur" class="py-20 md:py-28 bg-soft relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    6 Kemampuan Targeting
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Fitur yang kami optimalkan<br/>
                    <span class="text-accent">di setiap campaign.</span>
                </h2>
            </div>

            <FeatureGrid items={features} client:visible />
        </div>
    </section>

    <!-- ====================== HOW IT WORKS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, rgba(15,30,61,0.05) 1px, transparent 0); background-size: 32px 32px;"></div>

        <div class="container mx-auto px-6 relative">
            <div class="max-w-2xl mx-auto text-center mb-14 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-6 h-px bg-accent"></span>
                    Cara Kerja
                    <span class="w-6 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Empat langkah dari brief<br/>
                    <span class="text-accent">menuju iklan yang tayang optimal.</span>
                </h2>
            </div>

            <StepGrid items={steps} client:visible />
        </div>
    </section>

    <!-- ====================== PRICING ====================== -->
    <section id="pricing" class="py-20 md:py-28 bg-gradient-to-br from-soft via-white to-beige relative overflow-hidden">
        <div class="abs-blob abs-blob-3"></div>
        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Paket & Harga
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Dua paket, disesuaikan dengan<br/>
                    <span class="text-accent">tujuan bisnis Anda.</span>
                </h2>
                <p class="mt-4 text-muted max-w-xl mx-auto text-base leading-relaxed">
                    Pilih paket sesuai objective campaign: Standart untuk jangkauan rutin, Business untuk skala lebih besar dengan remarketing aktif.
                </p>
            </div>

            <PricingCards tiers={tiers} pageSlug="Kelola Instagram" highlightIndex={1} columns={3} client:only="svelte" />

            <div class="mt-10 max-w-2xl mx-auto reveal">
                <div class="bg-white rounded-2xl border border-gray-100 p-5 md:p-6 shadow-soft">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-xl bg-accent/15 flex items-center justify-center shrink-0">
                            <Check class="w-5 h-5 text-accent" strokeWidth="2.5" />
                        </div>
                        <div>
                            <p class="font-display font-bold text-base text-ink mb-1">Tidak yakin paket mana yang sesuai?</p>
                            <p class="text-sm text-muted leading-relaxed">Sesi konsultasi 15 menit gratis. Kami bantu pilih paket yang paling cocok dengan budget iklan dan objective campaign Anda.</p>
                            <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 mt-3 text-sm font-bold text-accent hover:text-ink transition-colors group">
                                Konsultasi via WhatsApp
                                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== COMPARISON TABLE ====================== -->
    <ComparisonTable serviceName="Instagram" />

    <!-- ====================== STATS / TRUST ====================== -->
    <section class="py-20 md:py-28 bg-ink text-white relative overflow-hidden">
        <div class="abs-radaial-1"></div>
        <div class="stat-orb stat-orb-1"></div>
        <div class="stat-orb stat-orb-2"></div>

        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Mengapa Tim Ini
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-white leading-[1.1] tracking-tight mt-3">
                    Bukan agensi yang berjanji<br/>
                    <span class="text-accent">angka fantastis tanpa dasar.</span>
                </h2>
                <p class="text-white/60 mt-4 text-base max-w-xl mx-auto">
                    Seluruh hasil berdasarkan data riil yang dapat Anda verifikasi sendiri. Bukan janji — hanya proses yang terukur.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto reveal-stagger">
                <div class="trust-item-dark">
                    <div class="trust-icon-dark">🔒</div>
                    <h3 class="trust-title-dark">Akses penuh ke akun Anda</h3>
                    <p class="trust-desc-dark">Seluruh akun Meta Ads tetap di bawah kendali Anda. Bila sewaktu-waktu dibutuhkan, seluruh data historis dan konfigurasi berpindah tanpa hambatan.</p>
                </div>
                <div class="trust-item-dark" style="animation-delay: 120ms;">
                    <div class="trust-icon-dark">📊</div>
                    <h3 class="trust-title-dark">Laporan setiap Senin pagi</h3>
                    <p class="trust-desc-dark">Disusun dalam satu halaman dengan bahasa yang mudah dipahami. Bukan sekadar deretan CPM-CTR-CPC — Anda mendapat kejelasan: mana yang berjalan optimal, dan mana yang perlu disesuaikan.</p>
                </div>
                <div class="trust-item-dark" style="animation-delay: 240ms;">
