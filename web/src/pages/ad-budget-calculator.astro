---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import BudgetCalculator from '../components/BudgetCalculator.svelte';
import Footer from '../components/Footer.svelte';
---

<Layout
    title="Online Ad Budget Calculator — Estimate Facebook, Google & TikTok Ad Costs | Beriklan"
    description="Estimate your digital ad budget for Facebook Ads, Google Ads, TikTok, Instagram & YouTube. Enter your revenue target and platforms to get budget and management-fee recommendations."
    canonical="https://beriklan.my/ad-budget-calculator/"
    breadcrumb={[
        { name: "Home", url: "https://beriklan.my/" },
        { name: "Ad Budget Calculator", url: "https://beriklan.my/ad-budget-calculator/" }
    ]}
>
    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <header class="relative pt-28 md:pt-44 pb-16 md:pb-20 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="container mx-auto px-6 relative z-10 text-center max-w-3xl mx-auto">
            <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-[2.75rem] xl:text-6xl text-ink leading-[1.05] tracking-tight">
                Online Ad Budget Calculator
            </h1>
            <p class="mt-5 text-base md:text-lg text-muted leading-relaxed max-w-2xl mx-auto">
                Not sure how much ad budget is right? Enter your revenue target, pick your platforms, and get a matching <strong class="text-ink">monthly ad spend + management fee</strong> estimate.
            </p>
        </div>
    </header>

    <BudgetCalculator client:only="svelte" />

    <section class="py-20 md:py-28 bg-white">
        <div class="container mx-auto px-6 max-w-3xl">
            <h2 class="font-display font-extrabold text-2xl md:text-3xl text-ink mb-6">How to use the ad budget calculator</h2>
            <div class="space-y-4 text-muted text-base leading-relaxed">
                <p><strong class="text-ink">1. Pick platforms</strong> — Choose one or more ad platforms you want to use (Facebook, Instagram, TikTok, Google or YouTube).</p>
                <p><strong class="text-ink">2. Set a goal</strong> — What is the campaign's main objective? Leads, sales, brand awareness or website traffic?</p>
                <p><strong class="text-ink">3. Revenue target</strong> — Estimate the monthly revenue you want the ads to generate.</p>
                <p><strong class="text-ink">4. Get results</strong> — The calculator returns a typical ad budget + management fee estimate.</p>
            </div>
            <div class="mt-10 p-6 bg-beige rounded-2xl">
                <h3 class="font-display font-bold text-lg text-ink mb-2">Need help shaping the strategy?</h3>
                <p class="text-sm text-muted mb-4">The Beriklan team can help you build a measurable ad strategy — from platform selection to campaign optimisation.</p>
                <a href="https://wa.me/62811919328?text=Hello%20Beriklan%2C%20I%20need%20help%20shaping%20my%20ad%20strategy%20after%20using%20the%20budget%20calculator." target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-ink text-white px-6 py-3 rounded-full font-bold text-sm hover:bg-primary-2 transition">
                    Contact Us via WhatsApp →
                </a>
            </div>
        </div>
    </section>

    <Footer />
</Layout>
