---
import Layout from '../layouts/Layout.astro';

import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import HeroVisual from '../components/HeroVisual.svelte';
import PainPoints from '../components/PainPoints.svelte';
import AuditTool from '../components/AuditTool.svelte';
import Method from '../components/Method.svelte';
import Services from '../components/Services.svelte';
import Testimonials from '../components/Testimonials.svelte';
import Faq from '../components/Faq.svelte';
import Footer from '../components/Footer.svelte';

const waLink = "https://wa.me/62811919328?text=Hello%20Beriklan%2C%20I%27d%20like%20an%20audit%20of%20my%20ad%20campaigns";

// P1: SEO — structured data (FAQ + Breadcrumb + LocalBusiness)
const faq = [
    { question: "How much do Beriklan's digital marketing services cost?", answer: "Ad management packages start from RM 790 per month depending on the platform. Google Ads management starts from RM 990/month, website development from RM 1,499. Every package includes weekly reports, ongoing optimisation and full access to your own ad accounts." },
    { question: "Is there a minimum contract?", answer: "No minimum contract. You can stop at any time without penalty. We would rather keep you with results than lock you into a long contract." },
    { question: "How long does campaign setup take?", answer: "Initial setup takes 1-3 working days for straightforward campaigns, and 5-7 days for complex multi-platform campaigns. After setup, optimisation runs every week." },
    { question: "Is the Beriklan team certified?", answer: "Yes. Our team is a Meta Business Partner (Facebook & Instagram) and Google Partner. These certifications mean we follow platform best practices and have direct access to platform support." },
    { question: "How do I track the results?", answer: "We set up Google Tag Manager + Google Analytics 4 + Meta Pixel on your website. You get real-time dashboard access to see traffic, leads and conversions. Weekly reports are sent via WhatsApp or email." },
    { question: "Is there a results guarantee?", answer: "We cannot guarantee specific numbers because advertising is dynamic. What we do guarantee: data transparency, regular reports and continuous optimisation. If ROI is off-track in the first month, we review the strategy at no extra cost." },
];

const breadcrumb = [
    { name: "Home", url: "https://beriklan.my/" }
];

const localBusiness = {
    name: "Beriklan.co.id",
    description: "Performance marketing agency serving Malaysia — managing Meta, Google and TikTok Ads campaigns since 2016. Certified team, weekly reports and measurable strategy for SMEs and mid-sized businesses.",
    url: "https://beriklan.my",
    telephone: "+62-811-9193-328",
    email: "info@beriklan.my",
    address: {
        street: "Jl. Arcamanik Endah No.76",
        city: "Bandung",
        region: "Jawa Barat",
        postalCode: "40195",
        country: "ID"
    },
    geo: { lat: -6.9175, lng: 107.6191 },
    openingHours: ["Mo-Sa 09:00-18:00"],
    priceRange: "RM 790 - RM 6,999",
    image: "https://beriklan.my/logoweb.webp",
    sameAs: [
        "https://www.instagram.com/beriklan.my",
        "https://www.facebook.com/beriklan.my"
    ]
};
---

<Layout
    title="Beriklan.my — Digital Marketing Agency Malaysia | Since 2016"
    description="Performance marketing agency for Malaysia — Facebook Ads, Google Ads, TikTok Ads. Meta & Google certified team managing campaigns since 2016. Free 15-minute initial consultation."
    canonical="https://beriklan.my/"
    faq={faq}
    breadcrumb={breadcrumb}
    localBusiness={localBusiness}
>
    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <script is:inline>
        window.adsbygoogle = window.adsbygoogle || [];
        window.__loadAdSense = function() {
            if (window.__adSenseLoaded) return;
            window.__adSenseLoaded = true;
            var s = document.createElement('script');
            s.async = true;
            s.src = 'https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4438184351486735';
            s.crossOrigin = 'anonymous';
            document.head.appendChild(s);
        };
        ['scroll','click','touchstart','keydown'].forEach(function(evt){ window.addEventListener(evt, window.__loadAdSense, {once:true, passive:true}); });
        setTimeout(window.__loadAdSense, 3000);
    </script>

    <!-- ====================== HERO ====================== -->
    <header class="hero relative pt-28 md:pt-44 pb-16 md:pb-28 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="absolute inset-0 opacity-[0.4] pointer-events-none hero-grid"></div>
        <div class="abs-blob abs-blob-1"></div>
        <div class="abs-blob abs-blob-2"></div>

        <!-- Decorative dotted line -->
        <svg class="absolute left-1/2 -translate-x-1/2 top-32 w-40 h-12 opacity-30 hidden lg:block" viewBox="0 0 160 40" aria-hidden="true">
            <path d="M5,20 Q40,5 80,20 T155,20" stroke="#0f1e3d" stroke-width="1.5" fill="none" stroke-dasharray="3 5"/>
        </svg>

        <div class="container mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">
            <div class="space-y-7 text-center lg:text-left">
                <!-- Eyebrow -->
                <div class="hero-eyebrow inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-ink font-semibold rounded-full text-xs tracking-wider uppercase shadow-sm">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
                    </span>
                    <span class="opacity-0 anim-fade-in">Performance Agency · Since 2016</span>
                </div>

                <h1 class="hero-h1 font-display font-extrabold text-4xl md:text-5xl lg:text-[2.75rem] xl:text-6xl text-ink leading-[1.05] tracking-tight">
                    <span class="anim-fade-up">Ads running,</span><br/>
                    <span class="anim-fade-up" style="animation-delay: 80ms;">but <span class="text-transparent bg-clip-text bg-gradient-to-r from-primary-2 to-accent">sales stay quiet.</span></span><br/>
                    <span class="anim-fade-up" style="animation-delay: 160ms;">We know <span class="underline decoration-accent decoration-4 underline-offset-4">exactly what</span> to fix.</span>
                </h1>

                <p class="hero-sub text-base md:text-lg text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 anim-fade-up" style="animation-delay: 240ms;">
                    From the hundreds of campaigns we have audited across industries, one pattern repeats: <strong class="text-ink">budget goes out</strong>, but the results do not match. The cause is usually one of three — <strong class="text-ink">targeting spread too wide</strong>, <strong class="text-ink">ads that miss the audience</strong>, or <strong class="text-ink">a landing page that does not close</strong>. We diagnose first — then build a measurable strategy for your business.
                </p>

                <div class="hero-ctas flex flex-col sm:flex-row gap-3 justify-center lg:justify-start pt-2 anim-fade-up" style="animation-delay: 320ms;">
                    <a href={waLink} target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center gap-2 bg-ink text-white px-7 py-4 rounded-full font-bold shadow-lg hover:shadow-pop overflow-hidden btn-shine">
                        <span class="relative z-10 flex items-center gap-2">
                            Request a Free 15-Minute Audit
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 group-hover:rotate-12 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </span>
                    </a>
                    <a href="#services" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-bold text-ink border border-gray-200 bg-white hover:border-ink hover:-translate-y-0.5 transition-all">
                        View Services &amp; Pricing
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                </div>

                <div class="hero-trust pt-5 border-t border-gray-200/60 flex flex-wrap items-center justify-center lg:justify-start gap-x-3 gap-y-2 text-xs md:text-sm reveal" style="transition-delay: 200ms;">
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted"><strong class="text-ink">9 tahun</strong> mengelola iklan berbagai industri</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted"><strong class="text-ink">Meta &amp; Google</strong> certified team</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Reports <strong class="text-ink">every Monday</strong>, clear &amp; structured</span></div>
                </div>
            </div>

            <div class="relative flex justify-center lg:justify-end">
                <HeroVisual client:only="svelte" />
            </div>
        </div>

        <div class="absolute bottom-6 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-1 text-muted text-[10px] uppercase tracking-widest font-bold scroll-cue">
            Scroll
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"/></svg>
        </div>
    </header>

    <!-- ====================== TRUST BAR (industries) ====================== -->
    <section class="py-7 bg-ink border-y border-white/5 relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                <p class="text-[10px] md:text-xs font-bold uppercase tracking-[0.18em] text-white/40">Trusted by businesses across industries</p>
                <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/70 text-sm font-semibold trust-word">
                    <span>F&amp;B</span><span class="text-white/30">·</span>
                    <span>Fashion</span><span class="text-white/30">·</span>
                    <span>Skincare</span><span class="text-white/30">·</span>
                    <span>Edutech</span><span class="text-white/30">·</span>
                    <span>SaaS B2B</span><span class="text-white/30">·</span>
                    <span>Clinics</span><span class="text-white/30">·</span>
                    <span>Property</span><span class="text-white/30">·</span>
                    <span>Tour &amp; Travel</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== PAIN POINTS ====================== -->
    <PainPoints client:only="svelte" />

    <!-- ====================== AUDIT TOOL ====================== -->
    <AuditTool client:only="svelte" />

    <!-- ====================== METHOD ====================== -->
    <Method client:only="svelte" />

    <!-- ====================== SERVICES ====================== -->
    <Services client:only="svelte" />

    <!-- ====================== STATS / TRUST ====================== -->
    <section class="py-20 md:py-28 bg-ink text-white relative overflow-hidden">
        <div class="abs-radaial-1"></div>
        <!-- floating dots -->
        <div class="stat-orb stat-orb-1"></div>
        <div class="stat-orb stat-orb-2"></div>

        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    How We Work
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-white leading-[1.1] tracking-tight mt-3">
                    Tiga pilar kerja<br/>
                    <span class="text-accent">that set us apart.</span>
                </h2>
                <p class="text-white/60 mt-4 text-base max-w-xl mx-auto">
                    Not just promises on paper. You can verify every pillar yourself — from weekly reports and full access to your Meta/Google dashboards, to cost breakdowns that are clear from day one.
                </p>
            </div>

            <div class="grid md:grid-cols-4 gap-4 max-w-5xl mx-auto reveal-stagger">
                <div class="stat-card">
                    <div class="stat-num">9 th</div>
                    <div class="stat-label">Pengalaman tim</div>
                    <div class="stat-bar"><span style="width: 90%"></span></div>
                    <p class="stat-foot">of performance marketing since 2016</p>
                </div>
                <div class="stat-card" style="animation-delay: 80ms;">
                    <div class="stat-num">7</div>
                    <div class="stat-label">Channel terkelola</div>
                    <div class="stat-bar"><span style="width: 100%"></span></div>
                    <p class="stat-foot">Meta, Google, TikTok, YouTube</p>
                </div>
                <div class="stat-card" style="animation-delay: 160ms;">
                    <div class="stat-num">12+</div>
                    <div class="stat-label">Sektor industri</div>
                    <div class="stat-bar"><span style="width: 76%"></span></div>
                    <p class="stat-foot">F&B, klinik, SaaS, retail</p>
                </div>
                <div class="stat-card" style="animation-delay: 240ms;">
                    <div class="stat-num">100%</div>
                    <div class="stat-label">Laporan transparan</div>
                    <div class="stat-bar"><span style="width: 100%"></span></div>
                    <p class="stat-foot">not just numbers without explanation</p>
                </div>
            </div>

            <div class="mt-14 grid md:grid-cols-3 gap-5 max-w-5xl mx-auto reveal-stagger">
                <div class="trust-item" style="animation-delay: 280ms;">
                    <div class="trust-icon">🔒</div>
                    <h3 class="trust-title">Full access to your accounts</h3>
                    <p class="trust-desc">All Meta, Google and TikTok accounts stay under your control. If you ever need to move on, all historical data and configurations transfer without friction.</p>
                </div>
                <div class="trust-item" style="animation-delay: 360ms;">
                    <div class="trust-icon">📊</div>
                    <h3 class="trust-title">Reports every Monday</h3>
                    <p class="trust-desc">Written on a single page in plain language. Not rows of numbers without a story — you get clarity: what is performing well, and what needs adjusting.</p>
                </div>
                <div class="trust-item" style="animation-delay: 440ms;">
                    <div class="trust-icon">📅</div>
                    <h3 class="trust-title">No lock-in contract</h3>
                    <p class="trust-desc">A monthly working system. You are free to continue or stop at any time — none of the long contracts common at most agencies.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== ADSENSE (non-intrusive, post-stats) ====================== -->
    <section class="py-10 bg-white">
        <div class="container mx-auto px-6 max-w-4xl">
            <div class="p-5 bg-soft/30 rounded-xl border border-gray-100">
                <p class="text-[10px] font-bold uppercase tracking-wider text-muted text-center mb-3">Advertisement</p>
                <ins class="adsbygoogle"
                     style="display:block"
                     data-ad-format="autorelaxed"
                     data-ad-client="ca-pub-4438184351486735"
                     data-ad-slot="4505315237"></ins>
                <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
            </div>
        </div>
    </section>

    <!-- ====================== TESTIMONIALS ====================== -->
    <Testimonials client:only="svelte" />

    <!-- ====================== FAQ ====================== -->
    <section id="faq" class="py-20 md:py-28 bg-soft relative overflow-hidden">
        <svg class="absolute -left-12 top-16 w-40 h-40 opacity-40 hidden md:block faq-deco" viewBox="0 0 100 100" aria-hidden="true">
            <defs>
                <linearGradient id="faqGrad1" x1="0" x2="1" y1="0" y2="1">
                    <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.5"/>
                    <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
                </linearGradient>
            </defs>
            <circle cx="50" cy="50" r="42" fill="none" stroke="url(#faqGrad1)" stroke-width="2" stroke-dasharray="4 6"/>
            <circle cx="50" cy="50" r="28" fill="none" stroke="#f59e0b" stroke-opacity="0.3" stroke-width="1.5"/>
            <text x="50" y="58" text-anchor="middle" font-size="36" font-weight="900" fill="#f59e0b" fill-opacity="0.2">?</text>
        </svg>
        <svg class="absolute -right-10 bottom-24 w-28 h-28 opacity-50 hidden md:block" viewBox="0 0 100 100" aria-hidden="true">
            <circle cx="50" cy="50" r="35" fill="none" stroke="#0ea5e9" stroke-opacity="0.25" stroke-width="2" stroke-dasharray="2 5"/>
            <circle cx="50" cy="50" r="6" fill="#0ea5e9" fill-opacity="0.3">
                <animate attributeName="r" values="6;9;6" dur="2.5s" repeatCount="indefinite"/>
            </circle>
        </svg>
        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Before starting, these usually get asked
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    The questions that come up most<br/>
                    <span class="text-accent">before the first deal.</span>
                </h2>
            </div>
            <Faq client:only="svelte" />
        </div>
    </section>

    <!-- ====================== FINAL CTA ====================== -->
    <section class="py-20 md:py-28 bg-gradient-to-br from-ink via-primary-2 to-ink text-white relative overflow-hidden">
        <div class="absolute inset-0 pointer-events-none opacity-[0.08] cta-grid"></div>
        <div class="abs-radaial-2"></div>

        <div class="floating-emoji emoji-1 hidden lg:flex">📈</div>
        <div class="floating-emoji emoji-2 hidden lg:flex">💬</div>
        <div class="floating-emoji emoji-3 hidden lg:flex">🚀</div>

        <div class="container mx-auto px-6 relative">
            <div class="max-w-3xl mx-auto text-center reveal">
                <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm border border-white/20 rounded-full text-xs font-bold uppercase tracking-wider mb-6">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-green-400"></span>
                    </span>
                    Team online &middot; replies within 1 hour
                </div>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl lg:text-6xl leading-[1.05] tracking-tight mb-6 mt-3">
                    Not sure whether your ads<br/>
                    <span class="text-accent">are performing at their best?</span>
                </h2>
                <p class="text-white/70 text-base md:text-lg max-w-xl mx-auto mb-10 leading-relaxed">
                    We offer a free 15-minute review — just describe your campaign situation via WhatsApp, no account access needed. Our team helps identify what can be improved, then gives concrete recommendations you can act on right away.
                </p>
                <div class="flex flex-col sm:flex-row gap-3 justify-center">
                    <a href={waLink} target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center gap-2 bg-accent text-ink px-7 py-4 rounded-full font-bold shadow-lg hover:shadow-pop overflow-hidden btn-shine-accent">
                        <span class="relative z-10 flex items-center gap-2">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:rotate-12 transition" fill="currentColor" viewBox="0 0 24 24"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448L.057 24z"/></svg>
                            Start a WhatsApp Chat
                        </span>
                    </a>
                    <a href="mailto:info@beriklan.my" class="inline-flex items-center justify-center gap-2 border border-white/20 text-white font-bold px-7 py-4 rounded-full hover:bg-white/5 hover:-translate-y-1 transition-all">
                        Or email info@beriklan.my
                    </a>
                </div>
                <div class="mt-8 flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-xs text-white/55">
                    <span class="flex items-center gap-1.5"><span class="check-icon-dark"></span> Minimum engagement 1 month</span>
                    <span class="flex items-center gap-1.5"><span class="check-icon-dark"></span> Stop any time, no penalty</span>
                    <span class="flex items-center gap-1.5"><span class="check-icon-dark"></span> Transparent pricing, no ad-spend markup</span>
                </div>
            </div>
        </div>
    </section>

    <Footer />
</Layout>

<style is:global>
    /* ====================== ANIMATIONS ====================== */

    /* Fade up baseline */
    .anim-fade-up {
        animation: fadeUp 0.8s cubic-bezier(0.22, 1, 0.36, 1) 0.2s forwards;
    }
    .anim-fade-in {
        animation: fadeIn 0.6s ease 0.4s forwards;
    }
    @keyframes fadeUp {
        from { opacity: 0; transform: translateY(24px); }
        to { opacity: 1; transform: translateY(0); }
    }
    @keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    /* Scroll cue + hero floating */
    .scroll-cue { animation: bounce-soft 2s ease-in-out infinite; }
    @keyframes bounce-soft {
        0%, 100% { transform: translate(-50%, 0); }
        50% { transform: translate(-50%, 6px); }
    }

    /* Hero grid pattern */
    .hero-grid {
        background-image: linear-gradient(rgba(15,30,61,.04) 1px, transparent 1px), linear-gradient(90deg, rgba(15,30,61,.04) 1px, transparent 1px);
        background-size: 48px 48px;
    }

    /* Decorative blobs (GPU-accelerated) */
    .abs-blob {
        position: absolute; border-radius: 9999px;
        pointer-events: none; will-change: transform;
        transform: translateZ(0);
    }
    .abs-blob-1 {
        top: 5rem; right: -8rem;
        width: 420px; height: 420px;
        background: rgba(245, 158, 11, 0.10);
        filter: blur(48px);
        animation: float-shape 14s ease-in-out infinite;
    }
    .abs-blob-2 {
        bottom: 0; left: -5rem;
        width: 288px; height: 288px;
        background: rgba(14, 165, 233, 0.10);
        filter: blur(40px);
        animation: float-shape 11s ease-in-out infinite 1.5s;
    }
    @keyframes float-shape {
        0%, 100% { transform: translate(0, 0); }
        50% { transform: translate(0, -16px); }
    }

    /* CTA grid background */
    .cta-grid {
        background-image: linear-gradient(rgba(255,255,255,.4) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.4) 1px, transparent 1px);
        background-size: 56px 56px;
    }

    /* Radial bg for dark sections */
    .abs-radaial-1, .abs-radaial-2 {
        position: absolute; inset: 0; pointer-events: none;
    }
    .abs-radaial-1 {
        background:
            radial-gradient(circle at 85% 15%, rgba(245, 158, 11, 0.18) 0%, transparent 40%),
            radial-gradient(circle at 15% 85%, rgba(14, 165, 233, 0.14) 0%, transparent 40%);
    }
    .abs-radaial-2 {
        background:
            radial-gradient(circle at 85% 15%, rgba(245, 158, 11, 0.20) 0%, transparent 40%),
            radial-gradient(circle at 15% 85%, rgba(14, 165, 233, 0.15) 0%, transparent 40%);
    }

    /* Check icons (reusable) */
    .check-icon {
        width: 1.25rem; height: 1.25rem; border-radius: 9999px;
        background: rgba(16, 185, 129, 0.1);
        display: inline-flex; align-items: center; justify-content: center;
        flex-shrink: 0;
    }
    .check-icon::after {
        content: ""; width: 0.75rem; height: 0.75rem;
