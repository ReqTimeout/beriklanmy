---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import ROASCalculator from '../components/ROASCalculator.svelte';
import Footer from '../components/Footer.svelte';
---

<Layout
    title="Kalkulator ROAS — Hitung Return on Ad Spend Online | Beriklan"
    description="Calculate your ad campaign's ROAS (Return on Ad Spend) online. Enter total ad spend and revenue to get a ROAS score plus optimisation recommendations."
    canonical="https://beriklan.my/roas-calculator/"
    breadcrumb={[
        { name: "Home", url: "https://beriklan.my/" },
        { name: "Kalkulator ROAS", url: "https://beriklan.my/roas-calculator/" }
    ]}
>
    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <header class="relative pt-28 md:pt-44 pb-16 md:pb-20 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="container mx-auto px-6 relative z-10 text-center max-w-3xl mx-auto">
            <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-[2.75rem] xl:text-6xl text-ink leading-[1.05] tracking-tight">
                Kalkulator ROAS Online
            </h1>
            <p class="mt-5 text-base md:text-lg text-muted leading-relaxed max-w-2xl mx-auto">
                ROAS (Return on Ad Spend) measures how effectively every ringgit you spend on ads works. <strong class="text-ink">Enter your campaign data</strong> and see your ROAS score with optimisation recommendations.
            </p>
        </div>
    </header>

    <section class="py-16 md:py-20 bg-soft">
        <div class="container mx-auto px-6 max-w-2xl">
            <ROASCalculator client:only="svelte" />
        </div>
    </section>

    <section class="py-20 md:py-28 bg-white">
        <div class="container mx-auto px-6 max-w-3xl">
            <h2 class="font-display font-extrabold text-2xl md:text-3xl text-ink mb-6">What is ROAS?</h2>
            <div class="space-y-4 text-muted text-base leading-relaxed">
                <p>ROAS is a metric that measures the revenue generated for every ringgit spent on ads. The formula is simple: <strong class="text-ink">Total Revenue ÷ Total Ad Spend</strong>.</p>
                <p>Example: if you spend RM 5,000 on ads and generate RM 20,000, your ROAS is 4x — every RM 1 produces RM 4.</p>
                <h3 class="font-display font-bold text-lg text-ink mt-8 mb-3">Patokan Skor ROAS</h3>
                <ul class="space-y-2">
                    <li class="flex items-start gap-2"><span class="text-green-500 font-bold">🟢 4x+</span> <span>Very good — consider scaling the budget.</span></li>
                    <li class="flex items-start gap-2"><span class="text-accent font-bold">🟡 2x - 4x</span> <span>Cukup baik — masih ada ruang optimasi.</span></li>
                    <li class="flex items-start gap-2"><span class="text-red-500 font-bold">🔴 &lt; 2x</span> <span>Needs optimisation — review targeting, creative or the landing page.</span></li>
                </ul>
            </div>
        </div>
    </section>

    <Footer />
</Layout>
