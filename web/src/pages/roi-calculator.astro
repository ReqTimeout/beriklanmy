---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import ROICalculator from '../components/ROICalculator.svelte';
import Footer from '../components/Footer.svelte';
---

<Layout
    title="Ad ROI Calculator — Calculate Return on Investment Online | Beriklan"
    description="Calculate your ad campaign's ROI (Return on Investment) online. Enter ad budget, production costs, management fee and revenue to get an ROI percentage plus recommendations."
    canonical="https://beriklan.my/roi-calculator/"
    breadcrumb={[
        { name: "Home", url: "https://beriklan.my/" },
        { name: "Kalkulator ROI", url: "https://beriklan.my/roi-calculator/" }
    ]}
>
    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <header class="relative pt-28 md:pt-44 pb-16 md:pb-20 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="container mx-auto px-6 relative z-10 text-center max-w-3xl mx-auto">
            <h1 class="font-display font-extrabold text-4xl md:text-5xl lg:text-[2.75rem] xl:text-6xl text-ink leading-[1.05] tracking-tight">
                Kalkulator ROI Online
            </h1>
            <p class="mt-5 text-base md:text-lg text-muted leading-relaxed max-w-2xl mx-auto">
                    ROI calculates your campaign's net profit after deducting all costs — including <strong class="text-ink">ad budget, creative production costs and management fees</strong>.
            </p>
        </div>
    </header>

    <section class="py-16 md:py-20 bg-soft">
        <div class="container mx-auto px-6 max-w-2xl">
            <ROICalculator client:only="svelte" />
        </div>
    </section>

    <section class="py-20 md:py-28 bg-white">
        <div class="container mx-auto px-6 max-w-3xl">
            <h2 class="font-display font-extrabold text-2xl md:text-3xl text-ink mb-6">What is ROI?</h2>
            <div class="space-y-4 text-muted text-base leading-relaxed">
                <p><strong class="text-ink">Return on Investment (ROI)</strong> measures a campaign's net profit after all costs. Unlike ROAS, which only counts ad spend, ROI accounts for <strong class="text-ink">total costs</strong> including production and management.</p>
                <p>ROI formula: <strong class="text-ink">(Total Revenue - Total Costs) ÷ Total Costs × 100%</strong></p>
                <p>Example: revenue RM 20,000, total costs RM 10,000 → ROI = 100%.</p>
            </div>
        </div>
    </section>

    <Footer />
</Layout>
