---
import Layout from '../layouts/Layout.astro';

import Navbar from '../components/Navbar.svelte';
import StickyCTA from '../components/StickyCTA.svelte';
import OmnichannelMap from '../components/OmnichannelMap.svelte';
import PricingCards from '../components/PricingCards.svelte';
import FaqAccordion from '../components/FaqAccordion.svelte';
import PAASection from '../components/PAASection.astro';
import RelatedServices from '../components/RelatedServices.svelte';
import FeatureGrid from '../components/FeatureGrid.svelte';
import StepGrid from '../components/StepGrid.svelte';
import StatsBand from '../components/StatsBand.astro';
import ComparisonTable from '../components/ComparisonTable.astro';
import AuthorBio from '../components/AuthorBio.astro';
import Footer from '../components/Footer.svelte';
import relatedMap from '../data/related-services.json';
import { MessageCircle, ArrowRight, Target, Sparkles, Repeat, MapPin, Database, Users, Check, TrendingUp } from 'lucide-svelte';

const waLink = "https://wa.me/62811919328?text=Hi%20Beriklan%2C%20I%27m%20interested%20in%20your%20digital%20marketing%20services.%20Please%20share%20packages%20and%20pricing.";

const tiers = [
    { name: 'Starter', priceLabel: 'Free', duration: '60-minute session', tagline: 'A strategy consultation — walk away with a channel plan even if we never work together.', features: ['Funnel & ad account review', 'Channel mix recommendation', 'Budget allocation guidance', 'Priority quick-wins list', 'No obligation'], priceNote: 'free consultation', disclaimer: 'Ad budget is paid directly to the platform via your own account.' },
    { name: 'Growth', priceLabel: 'Custom', duration: '30-day cycles', tagline: 'Multi-channel management scoped to your targets.', features: ['2–3 channels managed (Meta/Google/TikTok)', 'Creative direction included', 'Landing page optimisation', 'Weekly consolidated reporting', 'Monthly strategy call'], priceNote: 'custom quote after consultation', disclaimer: 'Ad budget is paid directly to the platform via your own account.', highlight: true },
    { name: 'Scale', priceLabel: 'Custom', duration: '30-day cycles', tagline: 'Full-funnel programme for aggressive growth targets.', features: ['All channels + YouTube', 'Dedicated strategist & designer', 'CRO programme on pages', 'Weekly strategy rhythm', 'Quarterly executive review'], priceNote: 'custom quote after consultation', disclaimer: 'Ad budget is paid directly to the platform via your own account.' },
];

const features = [
    { iconName: 'Target', title: 'Omnichannel Strategy', desc: 'An integrated cross-channel approach: paid ads, organic and conversion. Every channel reinforces the others.' },
    { iconName: 'Sparkles', title: 'Strategy Consultation', desc: 'An initial session to understand your business, audience and objectives — with a recommendation of the channels that fit best.' },
    { iconName: 'Users', title: 'Specialist Team', desc: 'One team of paid ads, organic and website specialists. No need to coordinate multiple agencies.' },
    { iconName: 'BarChart3', title: 'Unified Reporting', desc: 'Cross-channel reporting in one document: easy to read, with action recommendations for the next period.' },
    { iconName: 'TrendingUp', title: 'Ongoing Optimisation', desc: 'Every week we optimise: pause what underperforms, scale what works. Data drives every decision.' },
    { iconName: 'MessageCircle', title: 'Regular Communication', desc: 'Weekly updates via WhatsApp or email. Monthly reports via video call. You always know where the campaign stands.' },
];

const steps = [
    { num: '01', tag: 'WEEK 1', title: 'Audit & Strategy', desc: 'We audit your current funnel and propose a channel mix with clear targets.' },
    { num: '02', tag: 'WEEK 2', title: 'Setup Sprint', desc: 'Accounts, tracking, creative and landing pages prepared in one coordinated sprint.' },
    { num: '03', tag: 'WEEK 3+', title: 'Launch & Learn', desc: 'Campaigns go live across the selected channels; early data guides quick corrections.' },
    { num: '04', tag: 'MONTHLY', title: 'Optimise & Reallocate', desc: 'Monthly review moves budget to winners and cuts what underperforms.' },
];

const faqs = [
    { q: 'What does the full-service engagement include?', a: 'Strategy, channel selection, campaign management across Meta/Google/TikTok, creative direction, landing pages and consolidated reporting — scoped to your goals after a consultation.' },
    { q: 'How is pricing determined?', a: 'Full-service scope is custom-quoted based on channels, volume and targets. Book a free consultation and we will propose a scope with clear deliverables and pricing.' },
    { q: 'Do you replace our internal team?', a: 'We usually complement it. Some clients hand us everything; others keep content in-house while we run paid media. The scope is built around what you already have.' },
    { q: 'How soon can we see results?', a: 'Paid campaigns generate data within days and meaningful optimisation within 2–4 weeks. We set expectations per channel during the consultation — no inflated promises.' },
    { q: 'Is there a minimum commitment?', a: 'Engagements run in 30-day cycles with a quarterly strategy rhythm. No long-term lock-in — the work has to justify itself.' },
];

const relatedItems = (relatedMap.services['digital-marketing-agency'] || []).map(item => ({
  icon: item.icon,
  label: item.label,
  desc: item.desc,
  href: '/' + item.slug + '/',
}));
---

<Layout
    title="Digital Marketing Agency Malaysia | Multi-Channel Growth — Beriklan"
    description="Multi-channel digital marketing: Facebook, Instagram, Google, TikTok, YouTube ads and landing pages, integrated for measurable growth. Free growth audit to start."
    canonical="https://beriklan.my/digital-marketing-agency/"
    faq={[
        { question: 'What does the full-service engagement include?', answer: 'Strategy, channel selection, campaign management across Meta/Google/TikTok, creative direction, landing pages and consolidated reporting — scoped to your goals after a consultation.' },
        { question: 'How is pricing determined?', answer: 'Full-service scope is custom-quoted based on channels, volume and targets. Book a free consultation and we will propose a scope with clear deliverables and pricing.' },
        { question: 'Do you replace our internal team?', answer: 'We usually complement it. Some clients hand us everything; others keep content in-house while we run paid media. The scope is built around what you already have.' },
        { question: 'How soon can we see results?', answer: 'Paid campaigns generate data within days and meaningful optimisation within 2–4 weeks. We set expectations per channel during the consultation — no inflated promises.' },
        { question: 'Is there a minimum commitment?', answer: 'Engagements run in 30-day cycles with a quarterly strategy rhythm. No long-term lock-in — the work has to justify itself.' }
    ]}
    breadcrumb={[
        { name: "Home", url: "https://beriklan.my/" },
        { name: "Digital Marketing Agency", url: "https://beriklan.my/digital-marketing-agency/" }
    ]}
    service={{
        name: "Digital Marketing Agency",
        description: "End-to-end digital marketing for Malaysian businesses — strategy, paid media, content and landing pages under one accountable team.",
        url: "https://beriklan.my/digital-marketing-agency/",
        priceRange: "Custom",
        serviceType: "Digital Marketing",
        areaServed: "Malaysia",
        provider: { name: "Beriklan.my", url: "https://beriklan.my" }
    }}
>

    <Navbar client:only="svelte" />
    <StickyCTA client:only="svelte" />

    <!-- ====================== HERO ====================== -->
    <header class="hero relative pt-28 md:pt-44 pb-16 md:pb-24 overflow-hidden bg-gradient-to-br from-white via-soft to-beige">
        <div class="absolute inset-0 opacity-[0.4] pointer-events-none hero-grid"></div>
        <div class="abs-blob abs-blob-1"></div>
        <div class="abs-blob abs-blob-2"></div>

        <svg class="absolute left-1/2 -translate-x-1/2 top-32 w-40 h-12 opacity-30 hidden lg:block" viewBox="0 0 160 40" aria-hidden="true">
            <path d="M5,20 Q40,5 80,20 T155,20" stroke="#0f1e3d" stroke-width="1.5" fill="none" stroke-dasharray="3 5"/>
        </svg>

        <div class="container mx-auto px-6 grid lg:grid-cols-2 gap-12 lg:gap-16 items-center relative z-10">
            <div class="space-y-7 text-center lg:text-left">
                <div class="hero-eyebrow inline-flex items-center gap-2 px-4 py-2 bg-white border border-gray-200 text-ink font-semibold rounded-full text-xs tracking-wider uppercase shadow-sm">
                    <span class="relative flex h-2 w-2">
                        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2 w-2 bg-accent"></span>
                    </span>
                    <span class="opacity-0 anim-fade-in">Digital Marketing Agency · Multi-Channel · Malaysia</span>
                </div>

                <h1 class="hero-h1 font-display font-extrabold text-4xl md:text-5xl lg:text-[2.6rem] xl:text-[2.9rem] text-ink leading-[1.05] tracking-tight">
                    <span class="anim-fade-up">Digital Marketing</span><br/>
                    <span class="anim-fade-up text-transparent bg-clip-text bg-gradient-to-r from-primary-2 to-accent" style="animation-delay: 80ms;">That Grows Your Business</span><br/>
                    <span class="anim-fade-up" style="animation-delay: 160ms;">Through the Right Channels.</span>
                </h1>

                <p class="hero-sub text-base md:text-lg text-muted leading-relaxed max-w-xl mx-auto lg:mx-0 anim-fade-up" style="animation-delay: 240ms;">
                    We manage Facebook, Instagram, Google, TikTok and YouTube ads plus landing pages to bring in new customers, measurably. Every ringgit you invest is monitored closely, with reports you can actually understand.
                </p>

                <div class="hero-ctas flex flex-col sm:flex-row gap-3 justify-center lg:justify-start pt-2 anim-fade-up" style="animation-delay: 320ms;">
                    <a href={waLink} target="_blank" rel="noopener" class="group relative inline-flex items-center justify-center gap-2 bg-ink text-white px-7 py-4 rounded-full font-bold shadow-lg hover:shadow-pop overflow-hidden btn-shine">
                        <span class="relative z-10 flex items-center gap-2">
                            Chat on WhatsApp
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 group-hover:translate-x-1 group-hover:rotate-12 transition" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
                        </span>
                    </a>
                    <a href="#pricing" class="inline-flex items-center justify-center gap-2 px-7 py-4 rounded-full font-bold text-ink border border-gray-200 bg-white hover:border-ink hover:-translate-y-0.5 transition-all">
                        View Packages & Pricing
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
                    </a>
                </div>

                <div class="hero-trust pt-6 border-t border-gray-200/60 flex flex-wrap items-center justify-center lg:justify-start gap-x-6 gap-y-3 text-xs md:text-sm reveal" style="transition-delay: 200ms;">
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted"><strong class="text-ink">9 years</strong> managing ad campaigns</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Data-driven optimisation, not guesswork</span></div>
                    <div class="flex items-center gap-2 trust-item"><span class="check-icon"></span><span class="text-muted">Reports <strong class="text-ink">every Monday</strong>, in plain language</span></div>
                </div>
            </div>

            <div class="relative flex justify-center lg:justify-end anim-fade-up" style="animation-delay: 400ms;">
                <OmnichannelMap client:only="svelte" />
            </div>
        </div>
    </header>

    <!-- ====================== TRUST BAR ====================== -->
    <section class="py-7 bg-ink border-y border-white/5 relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="flex flex-wrap items-center justify-center gap-x-8 gap-y-3">
                <p class="text-[10px] md:text-xs font-bold uppercase tracking-[0.18em] text-white/40">Trusted by businesses across industries</p>
                <div class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 text-white/70 text-sm font-semibold trust-word">
                    <span>F&amp;B</span><span class="text-white/30">·</span>
                    <span>Skincare</span><span class="text-white/30">·</span>
                    <span>Fashion</span><span class="text-white/30">·</span>
                    <span>Edutech</span><span class="text-white/30">·</span>
                    <span>SaaS B2B</span><span class="text-white/30">·</span>
                    <span>Clinics</span><span class="text-white/30">·</span>
                    <span>Property</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== STATS BAND ====================== -->
    <StatsBand />

    <!-- ====================== WHY FACEBOOK ADS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Why Our Approach
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Not just running ads everywhere,<br/>
                    <span class="text-accent">but integrating channels for optimal results.</span>
                </h2>
                <p class="mt-4 text-muted max-w-xl mx-auto text-base leading-relaxed">
                    Digital marketing is not just about running ads on many platforms. What matters more is integrating every channel so they reinforce each other: Facebook Ads for awareness, Google Ads for high intent, landing pages for conversion, and so on. Our team manages that integration end-to-end.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto reveal-stagger">
                <div class="why-card group">
                    <div class="why-icon">🎯</div>
                    <h3 class="why-title">Pendekatan Omnichannel</h3>
                    <p class="why-desc">Every channel has a specific role in the funnel. We manage the integration so the audience journey from awareness to conversion feels seamless.</p>
                </div>
                <div class="why-card group" style="animation-delay: 100ms;">
                    <div class="why-icon">📊</div>
                    <h3 class="why-title">Unified Reporting</h3>
                    <p class="why-desc">Cross-channel reporting in a single document: which channels perform, which need iteration, and how they contribute to each other.</p>
                </div>
                <div class="why-card group" style="animation-delay: 200ms;">
                    <div class="why-icon">💬</div>
                    <h3 class="why-title">Satu Tim, Banyak Spesialis</h3>
                    <p class="why-desc">No juggling multiple agencies. Our team has a specialist for every channel — all integrated in a single workflow.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== FEATURES GRID ====================== -->
    <section id="fitur" class="py-20 md:py-28 bg-soft relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    6 Kemampuan Targeting
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    The features we optimise<br/>
                    <span class="text-accent">in every campaign.</span>
                </h2>
            </div>

            <FeatureGrid items={features} client:visible />
        </div>
    </section>

    <!-- ====================== HOW IT WORKS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-30 pointer-events-none" style="background-image: radial-gradient(circle at 2px 2px, rgba(15,30,61,0.05) 1px, transparent 0); background-size: 32px 32px;"></div>

        <div class="container mx-auto px-6 relative">
            <div class="max-w-2xl mx-auto text-center mb-14 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-6 h-px bg-accent"></span>
                    How It Works
                    <span class="w-6 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Four steps from brief<br/>
                    <span class="text-accent">to ads running at their best.</span>
                </h2>
            </div>

            <StepGrid items={steps} client:visible />
        </div>
    </section>

    <!-- ====================== PRICING ====================== -->
    <section id="pricing" class="py-20 md:py-28 bg-gradient-to-br from-soft via-white to-beige relative overflow-hidden">
        <div class="abs-blob abs-blob-3"></div>
        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Packages & Pricing
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    Two packages, matched to<br/>
                    <span class="text-accent">your business goals.</span>
                </h2>
                <p class="mt-4 text-muted max-w-xl mx-auto text-base leading-relaxed">
                    Choose a package to match your campaign objective: Standard for consistent reach, Business for bigger scale with active remarketing.
                </p>
            </div>

            <PricingCards tiers={tiers} pageSlug="Digital Marketing" highlightIndex={1} columns={3} client:only="svelte" />

            <div class="mt-10 max-w-2xl mx-auto reveal">
                <div class="bg-white rounded-2xl border border-gray-100 p-5 md:p-6 shadow-soft">
                    <div class="flex items-start gap-3">
                        <div class="w-10 h-10 rounded-xl bg-accent/15 flex items-center justify-center shrink-0">
                            <Check class="w-5 h-5 text-accent" strokeWidth="2.5" />
                        </div>
                        <div>
                            <p class="font-display font-bold text-base text-ink mb-1">Not sure which package fits?</p>
                            <p class="text-sm text-muted leading-relaxed">A free 15-minute consultation. We help you pick the package that best fits your ad budget and campaign objective.</p>
                            <a href={waLink} target="_blank" rel="noopener" class="inline-flex items-center gap-1.5 mt-3 text-sm font-bold text-accent hover:text-ink transition-colors group">
                                Consult on WhatsApp
                                <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-0.5 transition-transform" />
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== COMPARISON TABLE ====================== -->
    <ComparisonTable serviceName="Digital Marketing" />

    <!-- ====================== STATS / TRUST ====================== -->
    <section class="py-20 md:py-28 bg-ink text-white relative overflow-hidden">
        <div class="abs-radaial-1"></div>
        <div class="stat-orb stat-orb-1"></div>
        <div class="stat-orb stat-orb-2"></div>

        <div class="container mx-auto px-6 relative">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Why This Team
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-white leading-[1.1] tracking-tight mt-3">
                    Not an agency that promises<br/>
                    <span class="text-accent">fantastic numbers with nothing behind them.</span>
                </h2>
                <p class="text-white/60 mt-4 text-base max-w-xl mx-auto">
                    Every result is based on real data you can verify yourself. No promises — just a measurable process.
                </p>
            </div>

            <div class="grid md:grid-cols-3 gap-5 max-w-5xl mx-auto reveal-stagger">
                <div class="trust-item-dark">
                    <div class="trust-icon-dark">🔒</div>
                    <h3 class="trust-title-dark">Full access to your account</h3>
                    <p class="trust-desc-dark">Your ad account stays fully under your control. If you ever need to move on, all historical data and configurations transfer without friction.</p>
                </div>
                <div class="trust-item-dark" style="animation-delay: 120ms;">
                    <div class="trust-icon-dark">📊</div>
                    <h3 class="trust-title-dark">A report every Monday morning</h3>
                    <p class="trust-desc-dark">One page, written in plain language. Not just rows of CPM-CTR-CPC — you get clarity on what is performing well and what needs adjusting.</p>
                </div>
                <div class="trust-item-dark" style="animation-delay: 240ms;">
                    <div class="trust-icon-dark">🔄</div>
                    <h3 class="trust-title-dark">No minimum contract</h3>
                    <p class="trust-desc-dark">We work in monthly cycles. You are free to continue or stop at any time — none of the 6–12 month contracts most other agencies impose.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- ====================== TESTIMONIALS ====================== -->
    <section class="py-20 md:py-28 bg-white relative overflow-hidden">
        <div class="container mx-auto px-6">
            <div class="text-center max-w-2xl mx-auto mb-12 reveal">
                <p class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-[0.2em] text-accent">
                    <span class="w-8 h-px bg-accent"></span>
                    Case Studies & Testimonials
                    <span class="w-8 h-px bg-accent"></span>
                </p>
                <h2 class="font-display font-extrabold text-3xl md:text-5xl text-ink leading-[1.1] tracking-tight mt-3">
                    The experience of those who have<br/>
                    <span class="text-accent">worked with the Beriklan team.</span>
                </h2>
            </div>

            <div class="grid md:grid-cols-3 gap-5 max-w-6xl mx-auto reveal-stagger">
                <article class="tst-card">
                    <div class="tst-quote-mark">"</div>
                    <p class="tst-body">Our ROAS grew from 1.8x to 4.5x in four months. What we appreciated most: reports written in clear language, with every change explained so we could understand it.</p>
                    <div class="tst-author">
                        <div class="tst-avatar bg-gradient-to-br from-amber-500 to-orange-500">🧴</div>
                        <div>
                            <p class="tst-name">Nurul Aisyah</p>
                            <p class="tst-role">Owner · Skincare Brand, Kuala Lumpur</p>
                            <p class="tst-metric">ROAS 1.8x → 4.5x in 4 months</p>
                        </div>
                    </div>
                </article>
                <article class="tst-card" style="animation-delay: 100ms;">
                    <div class="tst-quote-mark">"</div>
                    <p class="tst-body">Every Monday morning there is a report in language we actually understand — not just rows of CPM and CTR, but what needs to change and why.</p>
                    <div class="tst-author">
                        <div class="tst-avatar bg-gradient-to-br from-pink-500 to-rose-500">💆</div>
                        <div>
                            <p class="tst-name">Amirul Hakim</p>
                            <p class="tst-role">Marketing Manager · Beauty Clinic, Petaling Jaya</p>
                            <p class="tst-metric">Consistent 3x more leads from month 2</p>
                        </div>
                    </div>
                </article>
                <article class="tst-card" style="animation-delay: 200ms;">
                    <div class="tst-quote-mark">"</div>
                    <p class="tst-body">A B2B funnel behaves very differently from FMCG. Beriklan understood this and built a strategy that fit. Qualified leads grew 180% in Q3.</p>
                    <div class="tst-author">
                        <div class="tst-avatar bg-gradient-to-br from-blue-500 to-indigo-500">💼</div>
                        <div>
                            <p class="tst-name">Rachel Ng</p>
                            <p class="tst-role">Head of Growth · B2B SaaS, Kuala Lumpur</p>
                            <p class="tst-metric">Qualified leads +180% in Q3 2025</p>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>

    <!-- ====================== FAQ ====================== -->
    <section id="faq" class="py-20 md:py-28 bg-soft relative overflow-hidden">
        <svg class="absolute -left-12 top-16 w-40 h-40 opacity-40 hidden md:block" viewBox="0 0 100 100" aria-hidden="true">
            <defs>
                <linearGradient id="faqGradFb" x1="0" x2="1" y1="0" y2="1">
                    <stop offset="0%" stop-color="#f59e0b" stop-opacity="0.5"/>
                    <stop offset="100%" stop-color="#f59e0b" stop-opacity="0"/>
                </linearGradient>
            </defs>
            <circle cx="50" cy="50" r="42" fill="none" stroke="url(#faqGradFb)" stroke-width="2" stroke-dasharray="4 6"/>
            <circle cx="50" cy="50" r="28" fill="none" stroke="#f59e0b" stroke-opacity="0.3" stroke-width="1.5"/>
