{
  "name": "beriklanmy",
  "main": "src/worker-entry.js",
  "routes": [
    { "pattern": "beriklan.my", "custom_domain": true },
    { "pattern": "www.beriklan.my", "custom_domain": true }
  ],
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beriklan-my-seo",
      "database_id": "9339554e-c00a-4b8c-96cf-2ccbf69a6e20"
    }
  ],
  "r2_buckets": [
    {
      "binding": "QUEUE",
      "bucket_name": "myberiklan"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ADMIN_TOKEN": "beriklan-my-admin-2026"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  }
  // crons dilepas: akun CF free sudah 5/5 cron trigger (beriklan-app 3 + beriklanweb 2).
  // Pengganti: cron-job.org GET /api/cron/tick?token=ADMIN_TOKEN tiap jam (menit 0).
}
