{
  "name": "beriklanweb",
  "main": "src/worker-entry.js",
  "compatibility_date": "2026-01-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "beriklan-my-seo",
      "database_id": "9339554e-c00a-4b8c-96cf-2ccbf69a6e20"
    }
  ],
  "r2_buckets": [
    {
      "binding": "QUEUE",
      "bucket_name": "myberiklan"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "vars": {
    "ADMIN_TOKEN": "beriklan-admin-2026"
  },
  "observability": {
    "enabled": true
  },
  "placement": {
    "mode": "smart"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "triggers": {
    "crons": [
      "0 * * * *",
      "*/15 * * * *"
    ]
  }
}
